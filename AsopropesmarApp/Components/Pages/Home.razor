@page "/"

<PageTitle>Inicio</PageTitle>

<!-- Hero Section con peces -->
<section id="inicio" class="hero-section">
    <!-- Peces nadando -->

    <div class="fish" style="top: 15%; animation-duration: 12s; animation-delay: 0s;">
        <span class="iconify" data-icon="noto:fish" style="font-size: 40px; color: #4bcffa;"></span>
    </div>
    <div class="fish" style="top: 35%; animation-duration: 18s; animation-delay: -5s;">
        <span class="iconify" data-icon="noto:fish" style="font-size: 32px; color: #f4d03f;"></span>
    </div>
    <div class="fish" style="top: 55%; animation-duration: 15s; animation-delay: -2s;">
        <span class="iconify" data-icon="noto:fish" style="font-size: 48px; color: #ff9f43;"></span>
    </div>
    <div class="fish" style="top: 75%; animation-duration: 20s; animation-delay: -8s;">
        <span class="iconify" data-icon="noto:fish" style="font-size: 36px; color: #0abde3;"></span>
    </div>

    <!-- Burbujas -->
    <div class="bubble" style="left: 10%; width: 20px; height: 20px; animation-duration: 4s; animation-delay: 0s;"></div>
    <div class="bubble" style="left: 20%; width: 15px; height: 15px; animation-duration: 5s; animation-delay: 1s;"></div>
    <div class="bubble" style="left: 30%; width: 25px; height: 25px; animation-duration: 6s; animation-delay: 2s;"></div>
    <div class="bubble" style="left: 40%; width: 10px; height: 10px; animation-duration: 3s; animation-delay: 0.5s;"></div>
    <div class="bubble" style="left: 50%; width: 18px; height: 18px; animation-duration: 4.5s; animation-delay: 1.5s;"></div>
    <div class="bubble" style="left: 60%; width: 22px; height: 22px; animation-duration: 5.5s; animation-delay: 0.8s;"></div>
    <div class="bubble" style="left: 70%; width: 12px; height: 12px; animation-duration: 3.5s; animation-delay: 2.2s;"></div>
    <div class="bubble" style="left: 80%; width: 30px; height: 30px; animation-duration: 7s; animation-delay: 0.3s;"></div>
    <div class="bubble" style="left: 90%; width: 16px; height: 16px; animation-duration: 4.8s; animation-delay: 1.2s;"></div>

    <div class="container h-100 position-relative z-1">
        <div class="row h-100 align-items-center">
            <div class="col-md-8 text-white">
                <h1 class="display-4 fw-bold mb-4">Tradición Pesquera en Manabí</h1>
                <p class="lead mb-4">Impulsando el desarrollo sostenible de nuestra comunidad pesquera artesanal, protegiendo nuestros recursos y mejorando la calidad de vida de nuestros asociados.</p>
                <a href="#contacto" class="btn btn-primary btn-lg me-3">Únete a Nosotros</a>
                <a href="#servicios" class="btn btn-outline-light btn-lg">Conoce Más</a>
            </div>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="py-5 bg-primary text-white">
    <div class="container">
        <div class="row text-center">
            <div class="col-md-3 mb-4 mb-md-0">
                <i class="bi bi-people-fill display-4 mb-3"></i>
                <h3 class="fw-bold">150+</h3>
                <p class="mb-0">Socios Activos</p>
            </div>
            <div class="col-md-3 mb-4 mb-md-0">
                <i class="bi bi-water display-4 mb-3"></i>
                <h3 class="fw-bold">50+</h3>
                <p class="mb-0">Embarcaciones</p>
            </div>
            <div class="col-md-3 mb-4 mb-md-0">
                <i class="bi bi-basket-fill display-4 mb-3"></i>
                <h3 class="fw-bold">2000+</h3>
                <p class="mb-0">Toneladas Anuales</p>
            </div>
            <div class="col-md-3">
                <i class="bi bi-calendar-check-fill display-4 mb-3"></i>
                <h3 class="fw-bold">15</h3>
                <p class="mb-0">Años de Experiencia</p>
            </div>
        </div>
    </div>
</section>

<!-- Nosotros -->
<section id="nosotros" class="py-5">
    <div class="container py-5">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <img src="Descarga del Día.jpg" alt="Pescadores" class="img-fluid rounded shadow">
            </div>
            <div class="col-lg-6 px-lg-5">
                <h6 class="text-primary fw-bold text-uppercase mb-2">Sobre Nosotros</h6>
                <h2 class="mb-4">Unidos por el Mar</h2>
                <p class="lead text-muted mb-4">Somos una organización dedicada a fortalecer y representar a los pescadores artesanales de Manabí.</p>
                <div class="row mt-4">
                    <div class="col-sm-6 mb-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-primary text-white rounded-circle p-3 me-3">
                                <i class="bi bi-bullseye fs-4"></i>
                            </div>
                            <h5 class="mb-0">Misión</h5>
                        </div>
                        <p class="text-muted">Promover el desarrollo integral de nuestros socios a través de prácticas sostenibles.</p>
                    </div>
                    <div class="col-sm-6 mb-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-primary text-white rounded-circle p-3 me-3">
                                <i class="bi bi-eye-fill fs-4"></i>
                            </div>
                            <h5 class="mb-0">Visión</h5>
                        </div>
                        <p class="text-muted">Ser la asociación pesquera referente en Ecuador por nuestra innovación y sostenibilidad.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Servicios -->
<section id="servicios" class="py-5 bg-light">
    <div class="container py-5">
        <div class="text-center mb-5">
            <h6 class="text-primary fw-bold text-uppercase mb-2">Nuestros Servicios</h6>
            <h2>¿Qué hacemos por nuestros socios?</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card service-card h-100 border-0 shadow-sm p-4">
                    <div class="card-body text-center">
                        <i class="bi bi-shield-check text-primary display-4 mb-4"></i>
                        <h4>Asesoría Legal</h4>
                        <p class="text-muted">Apoyo en trámites de permisos, matrículas y regulaciones pesqueras.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card service-card h-100 border-0 shadow-sm p-4">
                    <div class="card-body text-center">
                        <i class="bi bi-gear-fill text-primary display-4 mb-4"></i>
                        <h4>Mantenimiento</h4>
                        <p class="text-muted">Asistencia técnica para embarcaciones y motores fuera de borda.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card service-card h-100 border-0 shadow-sm p-4">
                    <div class="card-body text-center">
                        <i class="bi bi-graph-up-arrow text-primary display-4 mb-4"></i>
                        <h4>Comercialización</h4>
                        <p class="text-muted">Canales directos de venta para asegurar mejores precios a nuestros socios.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card service-card h-100 border-0 shadow-sm p-4">
                    <div class="card-body text-center">
                        <i class="bi bi-book text-primary display-4 mb-4"></i>
                        <h4>Capacitación</h4>
                        <p class="text-muted">Programas de formación en pesca sostenible y seguridad marítima.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card service-card h-100 border-0 shadow-sm p-4">
                    <div class="card-body text-center">
                        <i class="bi bi-box-seam text-primary display-4 mb-4"></i>
                        <h4>Suministros</h4>
                        <p class="text-muted">Provisión de artes de pesca y equipos a precios preferenciales.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card service-card h-100 border-0 shadow-sm p-4">
                    <div class="card-body text-center">
                        <i class="bi bi-heart-pulse text-primary display-4 mb-4"></i>
                        <h4>Bienestar Social</h4>
                        <p class="text-muted">Programas de salud y beneficios para las familias de nuestros asociados.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Galería -->
<section id="galeria" class="py-5">
    <div class="container py-5">
        <div class="text-center mb-5">
            <h6 class="text-primary fw-bold text-uppercase mb-2">Nuestra Labor</h6>
            <h2>Galería de Imágenes</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <img src="asopro.jpeg" alt="Pesca 1" class="img-fluid rounded shadow-sm w-100" style="object-fit: cover; height: 250px;">
            </div>
            <div class="col-md-4">
                <img src="Descarga del Día.jpg" alt="Pesca 2" class="img-fluid rounded shadow-sm w-100" style="object-fit: cover; height: 250px;">
            </div>
            <div class="col-md-4">
                <img src="producto.jpg" alt="Pesca 3" class="img-fluid rounded shadow-sm w-100" style="object-fit: cover; height: 250px;">
            </div>
        </div>
    </div>
</section>

<!-- Contacto -->
<section id="contacto" class="py-5 bg-light">
    <div class="container py-5">
        <div class="row">
            <div class="col-lg-6 mb-5 mb-lg-0">
                <h6 class="text-primary fw-bold text-uppercase mb-2">Contacto</h6>
                <h2 class="mb-4">Ponte en contacto con nosotros</h2>
                <p class="text-muted mb-4">Estamos aquí para responder tus consultas. Si eres pescador y deseas unirte a nuestra asociación, no dudes en contactarnos.</p>

                <div class="d-flex align-items-center mb-4">
                    <div class="bg-primary text-white rounded-circle p-3 me-3">
                        <i class="bi bi-geo-alt-fill fs-4"></i>
                    </div>
                    <div>
                        <h5 class="mb-1">Dirección</h5>
                        <p class="text-muted mb-0">Puerto Pesquero Artesanal, Manta, Manabí</p>
                    </div>
                </div>

                <div class="d-flex align-items-center mb-4">
                    <div class="bg-primary text-white rounded-circle p-3 me-3">
                        <i class="bi bi-telephone-fill fs-4"></i>
                    </div>
                    <div>
                        <h5 class="mb-1">Teléfono</h5>
                        <p class="text-muted mb-0">+593 99 999 9999</p>
                    </div>
                </div>

                <div class="d-flex align-items-center">
                    <div class="bg-primary text-white rounded-circle p-3 me-3">
                        <i class="bi bi-envelope-fill fs-4"></i>
                    </div>
                    <div>
                        <h5 class="mb-1">Email</h5>
                        <p class="text-muted mb-0">info@asopropesmar.org</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card border-0 shadow-sm p-4">
                    <div class="card-body">
                        <form id="contactForm">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <input type="text" class="form-control form-control-lg" placeholder="Nombre completo" required>
                                </div>
                                <div class="col-md-6">
                                    <input type="email" class="form-control form-control-lg" placeholder="Correo electrónico" required>
                                </div>
                                <div class="col-12">
                                    <input type="text" class="form-control form-control-lg" placeholder="Asunto" required>
                                </div>
                                <div class="col-12">
                                    <textarea class="form-control form-control-lg" rows="4" placeholder="Mensaje" required></textarea>
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn btn-primary btn-lg w-100">Enviar Mensaje</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Footer -->
<footer class="bg-dark text-white py-4">
    <div class="container text-center">
        <p class="mb-0">&copy; 2024 ASOPROPESMAR. Todos los derechos reservados.</p>
    </div>
</footer>

<!-- Modales -->
<!-- Login Modal (solo la estructura, su funcionalidad se trasladó a las páginas Razor) -->
<div class="modal fade" id="loginModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <img src="asopro.jpeg" alt="Logo" height="60" class="mb-3">
                    <h3 class="fw-bold">Iniciar Sesión</h3>
                    <p class="text-muted">Por favor, utilice el botón de inicio de sesión en el menú para acceder mediante el proveedor de identidad.</p>
                </div>
            </div>
        </div>
    </div>
</div>
