@page "/"

<PageTitle>Inicio - ASOPROPESMAR</PageTitle>

<!-- Hero Section -->
<section id="inicio" class="hero-section text-center">
    <div class="container position-relative z-index-1">
        <h1 class="display-3 fw-bold mb-4" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">ASOPROPESMAR</h1>
        <p class="lead fs-3 mb-5" style="text-shadow: 1px 1px 2px rgba(0,0,0,0.5);">Asociación de Producción Pesquera Manabí Artesanal</p>
        <a href="#asociados" class="btn btn-primary btn-lg rounded-pill px-5 py-3 fs-5 fw-bold shadow">
            Unirse a la Asociación <i class="bi bi-arrow-right ms-2"></i>
        </a>
    </div>
</section>

<!-- Nosotros -->
<section id="nosotros" class="section bg-light">
    <div class="container">
        <h2 class="section-title">Quiénes Somos</h2>
        <div class="row g-5 align-items-center mt-4">
            <div class="col-lg-6">
                <img src="Descarga del Día.jpg" alt="Pescadores" class="img-fluid rounded-4 shadow-lg w-100 object-fit-cover" style="height: 400px;">
            </div>
            <div class="col-lg-6">
                <h3 class="mb-4">Nuestra Historia</h3>
                <p class="lead text-muted">Somos una asociación comprometida con el desarrollo sostenible de la pesca artesanal en Manabí.</p>
                <div class="row g-4 mt-2">
                    <div class="col-md-6">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <i class="bi bi-bullseye fs-1 text-primary mb-3"></i>
                                <h4 class="card-title">Misión</h4>
                                <p class="card-text">Mejorar la calidad de vida de nuestros asociados a través de prácticas pesqueras sostenibles y comercio justo.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <i class="bi bi-eye fs-1 text-primary mb-3"></i>
                                <h4 class="card-title">Visión</h4>
                                <p class="card-text">Ser la asociación líder en innovación y sostenibilidad pesquera en la región costa del Ecuador.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Servicios -->
<section id="servicios" class="section">
    <div class="container">
        <h2 class="section-title">Nuestros Servicios</h2>
        <div class="row g-4 mt-4">
            <div class="col-md-4">
                <div class="card service-card h-100 border-0 shadow-sm">
                    <img src="producto.jpg" class="card-img-top object-fit-cover" alt="Productos" style="height: 250px;">
                    <div class="card-body text-center p-4">
                        <h4 class="card-title">Comercialización</h4>
                        <p class="card-text text-muted">Venta directa de productos del mar frescos y procesados con los mejores estándares de calidad.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card service-card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4 d-flex flex-column justify-content-center">
                        <i class="bi bi-shield-check display-1 text-primary mb-4"></i>
                        <h4 class="card-title">Asesoría Legal</h4>
                        <p class="card-text text-muted">Apoyo en trámites, permisos y regulaciones pesqueras para todos nuestros asociados.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card service-card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4 d-flex flex-column justify-content-center">
                        <i class="bi bi-tools display-1 text-primary mb-4"></i>
                        <h4 class="card-title">Mantenimiento</h4>
                        <p class="card-text text-muted">Servicios técnicos para embarcaciones y equipos de pesca artesanal.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Asociados (Dashboard) -->
<section id="asociados" class="section bg-light">
    <div class="container">
        <h2 class="section-title">Gestión de Asociados</h2>

        <div class="row g-4 mb-5 text-center">
            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-people-fill fs-1 mb-3"></i>
                    <div class="stat-number" id="totalMembers">0</div>
                    <p>Total Asociados</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-person-check-fill fs-1 mb-3"></i>
                    <div class="stat-number" id="activeMembers">0</div>
                    <p>Activos</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-person-dash-fill fs-1 mb-3"></i>
                    <div class="stat-number" id="inactiveMembers">0</div>
                    <p>Inactivos</p>
                </div>
            </div>
        </div>

        <div class="db-section">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="mb-0"><i class="bi bi-database me-2"></i>Base de Datos de Asociados</h4>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#memberModal">
                    <i class="bi bi-plus-circle me-1"></i> Nuevo Asociado
                </button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover" id="membersTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th>Tipo</th>
                            <th>Estado</th>
                            <th>Fecha</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="membersTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</section>
