@page "/"

<PageTitle>ASOPROPESMAR</PageTitle>

<!-- Hero Section -->
<section id="inicio" class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 hero-content text-white">
                <h1 class="display-4 fw-bold mb-4">Asociación de Producción Pesquera Manabí Artesanal</h1>
                <p class="lead mb-4">Uniendo fuerzas para el desarrollo sostenible de la pesca artesanal en nuestra región. Tradición, trabajo y progreso.</p>
                <div class="d-flex gap-3">
                    <a href="#nosotros" class="btn btn-primary btn-lg">Conócenos</a>
                    <a href="#directorio" class="btn btn-outline-light btn-lg">Portal Miembros</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Nosotros -->
<section id="nosotros" class="section">
    <div class="container">
        <h2 class="section-title">Quiénes Somos</h2>
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <img src="fondo.jpg" alt="Pescadores" class="img-fluid rounded shadow-lg">
            </div>
            <div class="col-lg-6">
                <h3 class="mb-4">Nuestra Historia</h3>
                <p class="lead text-muted">ASOPROPESMAR nació de la necesidad de unificar al sector pesquero artesanal de Manabí.</p>
                <p>Trabajamos diariamente para mejorar las condiciones de vida de nuestros asociados y promover prácticas de pesca responsables y sostenibles que garanticen el futuro de nuestra principal fuente de trabajo.</p>

                <div class="row mt-4">
                    <div class="col-sm-6 mb-3">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-bullseye fs-1 text-primary me-3"></i>
                            <div>
                                <h5 class="mb-1">Misión</h5>
                                <p class="small text-muted mb-0">Desarrollo integral del pescador.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-eye fs-1 text-primary me-3"></i>
                            <div>
                                <h5 class="mb-1">Visión</h5>
                                <p class="small text-muted mb-0">Líderes en pesca sostenible.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Servicios -->
<section id="servicios" class="section bg-light">
    <div class="container">
        <h2 class="section-title">Nuestros Servicios</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="service-card text-center p-4 h-100 bg-white rounded shadow-sm">
                    <div class="icon-box bg-primary text-white mx-auto mb-4">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h4>Asesoría Legal</h4>
                    <p class="text-muted">Apoyo en trámites marítimos, permisos de pesca y regularización de embarcaciones.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="service-card text-center p-4 h-100 bg-white rounded shadow-sm">
                    <div class="icon-box bg-primary text-white mx-auto mb-4">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <h4>Comercialización</h4>
                    <p class="text-muted">Búsqueda de mercados justos y canales directos de venta para nuestros productos.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="service-card text-center p-4 h-100 bg-white rounded shadow-sm">
                    <div class="icon-box bg-primary text-white mx-auto mb-4">
                        <i class="bi bi-book"></i>
                    </div>
                    <h4>Capacitación</h4>
                    <p class="text-muted">Talleres sobre seguridad marítima, buenas prácticas pesqueras y gestión financiera.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Directorio / Base de Datos -->
<section id="directorio" class="section">
    <div class="container">
        <h2 class="section-title">Gestión de Asociados</h2>
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-people-fill fs-1 mb-3"></i>
                    <div class="stat-number" id="totalMembers">0</div>
                    <p>Total Asociados</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-person-check-fill fs-1 mb-3"></i>
                    <div class="stat-number" id="activeMembers">0</div>
                    <p>Activos</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-person-dash-fill fs-1 mb-3"></i>
                    <div class="stat-number" id="inactiveMembers">0</div>
                    <p>Inactivos</p>
                </div>
            </div>
        </div>

        <div class="db-section">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="mb-0"><i class="bi bi-database me-2"></i>Base de Datos de Asociados</h4>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#memberModal">
                    <i class="bi bi-plus-circle me-1"></i> Nuevo Asociado
                </button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover" id="membersTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th>Tipo</th>
                            <th>Estado</th>
                            <th>Fecha</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="membersTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!-- Contacto -->
<section id="contacto" class="section contact-section">
    <div class="container">
        <h2 class="section-title" style="color: white;">Contacto</h2>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="contact-card">
                    <h4 class="mb-4"><i class="bi bi-geo-alt me-2"></i>Información de Contacto</h4>
                    <div class="mb-3">
                        <p><i class="bi bi-person-badge me-2"></i><strong>Representante:</strong> Walter González Klegan</p>
                        <p><i class="bi bi-telephone me-2"></i><strong>Teléfono:</strong> +593 981452439</p>
                        <p><i class="bi bi-envelope me-2"></i><strong>Email:</strong> info@asopropesmar.org.ec</p>
                        <p><i class="bi bi-geo-alt me-2"></i><strong>Ubicación:</strong> Manta, Manabí, Ecuador</p>
                        <p><i class="bi bi-clock me-2"></i><strong>Horario:</strong> Lunes a Viernes 8:00 - 17:00</p>
                    </div>
                    <div class="mt-4">
                        <a href="#" class="btn btn-outline-light me-2"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="btn btn-outline-light me-2"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="btn btn-outline-light"><i class="bi bi-whatsapp"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="contact-card">
                    <h4 class="mb-4"><i class="bi bi-map me-2"></i>Nuestra Ubicación</h4>
                    <div class="map-container">
                        <iframe src="https://www.openstreetmap.org/export/embed.html?bbox=-80.72%2C-0.96%2C-80.68%2C-0.92&amp;layer=mapnik&amp;marker=-0.95%2C-80.70"
                                width="100%" height="300" style="border:0; border-radius: 15px;" allowfullscreen loading="lazy"></iframe>
                    </div>
                    <p class="mt-3 text-center"><small> Puerto de Manta, Manabí - Ecuador</small></p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modal Nuevo Asociado -->
<div class="modal fade" id="memberModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>Nuevo Asociado</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="memberForm">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Nombres *</label>
                            <input type="text" class="form-control" id="memberFirstName" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Apellidos *</label>
                            <input type="text" class="form-control" id="memberLastName" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email *</label>
                        <input type="email" class="form-control" id="memberEmail" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Teléfono *</label>
                        <input type="tel" class="form-control" id="memberPhone" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tipo</label>
                        <select class="form-select" id="memberType">
                            <option value="pescador">Pescador</option>
                            <option value="acuicultor">Acuicultor</option>
                            <option value="procesador">Procesador</option>
                            <option value="comerciante">Comerciante</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Estado</label>
                        <select class="form-select" id="memberStatus">
                            <option value="activo">Activo</option>
                            <option value="inactivo">Inactivo</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Guardar</button>
                </form>
            </div>
        </div>
    </div>
</div>
