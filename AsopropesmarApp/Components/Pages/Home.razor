@page "/"

<PageTitle>ASOPROPESMAR - Asociación de Producción Pesquera Manabí Artesanal</PageTitle>

    <!-- Header / Hero Section -->
    <header id="inicio" class="hero-section text-center">
        <div class="container position-relative z-1">
            <h1 class="display-4 fw-bolder mb-3 text-shadow">ASOPROPESMAR</h1>
            <p class="lead mb-4 fw-bold">Asociación de Producción Pesquera Manabí Artesanal</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="#nosotros" class="btn btn-primary btn-lg"><i class="bi bi-info-circle me-2"></i>Conócenos</a>
                <a href="#contacto" class="btn btn-outline-light btn-lg"><i class="bi bi-envelope me-2"></i>Contáctanos</a>
            </div>
        </div>
    </header>

    <!-- Nosotros -->
    <section id="nosotros" class="section">
        <div class="container">
            <h2 class="section-title">Quiénes Somos</h2>
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <img src="fondo.jpg" alt="Pescadores" class="img-fluid rounded shadow-lg">
                </div>
                <div class="col-lg-6">
                    <div class="bg-white p-4 rounded shadow-sm">
                        <p class="lead">Representamos con orgullo a los pescadores artesanales de la provincia de Manabí.</p>
                        <ul class="list-unstyled mt-4">
                            <li class="mb-3"><i class="bi bi-check-circle-fill text-primary me-2"></i> <strong>Nuestra Misión:</strong> Promover el desarrollo sostenible y mejorar la calidad de vida de nuestros asociados.</li>
                            <li class="mb-3"><i class="bi bi-check-circle-fill text-primary me-2"></i> <strong>Nuestra Visión:</strong> Ser la asociación pesquera artesanal líder y más innovadora del Ecuador.</li>
                            <li class="mb-3"><i class="bi bi-check-circle-fill text-primary me-2"></i> <strong>Valores:</strong> Solidaridad, Trabajo en Equipo, Sostenibilidad, y Transparencia.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Servicios -->
    <section id="servicios" class="section bg-light">
        <div class="container">
            <h2 class="section-title">Nuestros Servicios</h2>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="service-card p-4 rounded bg-white shadow-sm h-100 text-center">
                        <div class="icon-wrapper mb-3 mx-auto bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                            <i class="bi bi-shield-check fs-2"></i>
                        </div>
                        <h4>Asesoría Legal</h4>
                        <p class="text-muted">Apoyo en trámites de permisos, matrículas y representación legal para nuestros afiliados.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="service-card p-4 rounded bg-white shadow-sm h-100 text-center">
                        <div class="icon-wrapper mb-3 mx-auto bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                            <span class="iconify fs-2" data-icon="mdi:fish"></span>
                        </div>
                        <h4>Capacitación</h4>
                        <p class="text-muted">Talleres sobre pesca sostenible, seguridad marítima y manejo de productos del mar.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="service-card p-4 rounded bg-white shadow-sm h-100 text-center">
                        <div class="icon-wrapper mb-3 mx-auto bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                            <i class="bi bi-graph-up-arrow fs-2"></i>
                        </div>
                        <h4>Comercialización</h4>
                        <p class="text-muted">Gestión conjunta para obtener mejores precios en la venta directa de nuestros productos.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Galería y Descargas -->
    <section id="galeria" class="section">
        <div class="container">
            <h2 class="section-title">Galería y Descargas</h2>
            <div class="row g-4">
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <img src="Descarga del Día.jpg" class="card-img-top" alt="Descarga">
                        <div class="card-body">
                            <h5 class="card-title">Descarga del Día</h5>
                            <p class="card-text text-muted">Faena diaria de nuestros pescadores en el puerto.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <img src="producto.jpg" class="card-img-top" alt="Producto fresco">
                        <div class="card-body">
                            <h5 class="card-title">Nuestros Productos</h5>
                            <p class="card-text text-muted">Calidad y frescura garantizada del mar a su mesa.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="card bg-primary text-white h-100 shadow-sm d-flex justify-content-center align-items-center p-4 text-center">
                        <i class="bi bi-file-earmark-pdf fs-1 mb-3"></i>
                        <h5>Estatutos de la Asociación</h5>
                        <p class="small">Conozca nuestros reglamentos internos y código de ética.</p>
                        <a href="#" class="btn btn-light mt-2"><i class="bi bi-download me-1"></i> Descargar PDF</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Panel de Asociados (Demo Visual) -->
    <section id="asociados" class="section bg-light">
        <div class="container">
            <h2 class="section-title">Gestión de Asociados</h2>
            <p class="text-center text-muted mb-5">Sistema integrado para el control de miembros de ASOPROPESMAR</p>

            <div class="row g-4 mb-5">
                <div class="col-md-4">
                    <div class="stat-card">
                        <i class="bi bi-people-fill fs-1 mb-3"></i>
                        <div class="stat-number" id="totalMembers">0</div>
                        <p>Total Asociados</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-card">
                        <i class="bi bi-person-check-fill fs-1 mb-3"></i>
                        <div class="stat-number" id="activeMembers">0</div>
                        <p>Activos</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-card">
                        <i class="bi bi-person-dash-fill fs-1 mb-3"></i>
                        <div class="stat-number" id="inactiveMembers">0</div>
                        <p>Inactivos</p>
                    </div>
                </div>
            </div>

            <div class="db-section">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="mb-0"><i class="bi bi-database me-2"></i>Base de Datos de Asociados</h4>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#memberModal">
                        <i class="bi bi-plus-circle me-1"></i> Nuevo Asociado
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover" id="membersTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Email</th>
                                <th>Teléfono</th>
                                <th>Tipo</th>
                                <th>Estado</th>
                                <th>Fecha</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="membersTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>

    <!-- Contacto -->
    <section id="contacto" class="section contact-section">
        <div class="container">
            <h2 class="section-title" style="color: white;">Contacto</h2>
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="contact-card">
                        <h4 class="mb-4"><i class="bi bi-geo-alt me-2"></i>Información de Contacto</h4>
                        <div class="mb-3">
                            <p><i class="bi bi-person-badge me-2"></i><strong>Representante:</strong> Walter González Klegan</p>
                            <p><i class="bi bi-telephone me-2"></i><strong>Teléfono:</strong> +593 981452439</p>
                            <p><i class="bi bi-envelope me-2"></i><strong>Email:</strong> info@asopropesmar.org.ec</p>
                            <p><i class="bi bi-geo-alt me-2"></i><strong>Ubicación:</strong> Manta, Manabí, Ecuador</p>
                            <p><i class="bi bi-clock me-2"></i><strong>Horario:</strong> Lunes a Viernes 8:00 - 17:00</p>
                        </div>
                        <div class="mt-4">
                            <a href="#" class="btn btn-outline-light me-2"><i class="bi bi-facebook"></i></a>
                            <a href="#" class="btn btn-outline-light me-2"><i class="bi bi-instagram"></i></a>
                            <a href="#" class="btn btn-outline-light"><i class="bi bi-whatsapp"></i></a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="contact-card">
                        <h4 class="mb-4"><i class="bi bi-map me-2"></i>Nuestra Ubicación</h4>
                        <div class="map-container">
                            <iframe src="https://www.openstreetmap.org/export/embed.html?bbox=-80.72%2C-0.96%2C-80.68%2C-0.92&amp;layer=mapnik&amp;marker=-0.95%2C-80.70"
                                    width="100%" height="300" style="border:0; border-radius: 15px;" allowfullscreen loading="lazy"></iframe>
                        </div>
                        <p class="mt-3 text-center"><small> Puerto de Manta, Manabí - Ecuador</small></p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Modal Nuevo Asociado -->
    <div class="modal fade" id="memberModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>Nuevo Asociado</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="memberForm">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nombres *</label>
                                <input type="text" class="form-control" id="memberFirstName" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Apellidos *</label>
                                <input type="text" class="form-control" id="memberLastName" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email *</label>
                            <input type="email" class="form-control" id="memberEmail" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Teléfono *</label>
                            <input type="tel" class="form-control" id="memberPhone" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Tipo</label>
                            <select class="form-select" id="memberType">
                                <option value="pescador">Pescador</option>
                                <option value="acuicultor">Acuicultor</option>
                                <option value="procesador">Procesador</option>
                                <option value="comerciante">Comerciante</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Estado</label>
                            <select class="form-select" id="memberStatus">
                                <option value="activo">Activo</option>
                                <option value="inactivo">Inactivo</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Guardar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>
