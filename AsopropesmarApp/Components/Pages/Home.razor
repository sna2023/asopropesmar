@page "/"

<PageTitle>ASOPROPESMAR - Asociación de Producción Pesquera Manabí Artesanal</PageTitle>

<div class="hero" id="inicio">
    <div class="hero-overlay"></div>
    <div class="hero-content text-center">
        <img src="asopro.jpeg" alt="ASOPROPESMAR Logo" class="hero-logo mb-4 shadow-lg rounded-circle" style="width: 250px; height: 250px; object-fit: cover; border: 4px solid white;">
        <h1 class="display-3 fw-bold mb-4">ASOPROPESMAR</h1>
        <p class="lead mb-5 fs-3">Asociación de Producción Pesquera Manabí Artesanal</p>
        <div class="d-flex justify-content-center gap-3">
            <a href="#nosotros" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold">Conócenos</a>
            <a href="#contacto" class="btn btn-outline-light btn-lg rounded-pill px-5 fw-bold">Contacto</a>
        </div>
    </div>
</div>

<section id="nosotros" class="section about-section">
    <div class="container">
        <h2 class="section-title text-center text-white mb-5">Sobre Nosotros</h2>
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <img src="fondo.jpg" alt="Pescadores" class="img-fluid rounded-4 shadow-lg w-100" style="object-fit: cover; height: 400px;">
            </div>
            <div class="col-lg-6">
                <div class="card bg-dark text-white border-0 shadow-lg" style="background-color: rgba(0,0,0,0.6) !important; backdrop-filter: blur(10px);">
                    <div class="card-body p-5">
                        <h3 class="fw-bold mb-4 text-primary"><i class="bi bi-water me-2"></i>Nuestra Historia</h3>
                        <p class="lead mb-4">Somos la Asociación de Producción Pesquera Manabí Artesanal, fundada con el propósito de unir y fortalecer a los pescadores artesanales de nuestra región.</p>
                        <p class="mb-4">Nuestro compromiso es con el desarrollo sostenible de la pesca, el bienestar de nuestras comunidades costeras y la preservación de los recursos marinos para las futuras generaciones.</p>
                        <div class="d-flex align-items-center gap-4 mt-5">
                            <div class="text-center">
                                <h2 class="text-primary fw-bold mb-0">200+</h2>
                                <p class="mb-0 text-white-50">Socios Activos</p>
                            </div>
                            <div style="width: 2px; height: 50px; background-color: rgba(255,255,255,0.2);"></div>
                            <div class="text-center">
                                <h2 class="text-primary fw-bold mb-0">15+</h2>
                                <p class="mb-0 text-white-50">Años de Experiencia</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="servicios" class="section services-section py-5 bg-dark text-white">
    <div class="container">
        <h2 class="section-title text-center mb-5">Nuestros Servicios</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 bg-secondary border-0 shadow text-center p-4">
                    <i class="bi bi-basket-fill display-4 text-primary mb-3"></i>
                    <h4>Comercialización</h4>
                    <p>Facilitamos la venta directa de productos pesqueros, asegurando precios justos para nuestros asociados.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 bg-secondary border-0 shadow text-center p-4">
                    <i class="bi bi-shield-check display-4 text-primary mb-3"></i>
                    <h4>Asesoría Legal</h4>
                    <p>Brindamos apoyo en trámites, permisos y regulaciones pesqueras vigentes.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 bg-secondary border-0 shadow text-center p-4">
                    <i class="bi bi-tools display-4 text-primary mb-3"></i>
                    <h4>Capacitación</h4>
                    <p>Programas de formación en técnicas de pesca sostenible y seguridad marítima.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="productos" class="section bg-dark text-white py-5">
    <div class="container">
        <h2 class="section-title text-center mb-5">Nuestros Productos</h2>
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0 order-lg-2">
                <img src="producto.jpg" alt="Productos" class="img-fluid rounded-4 shadow-lg w-100" style="object-fit: cover; height: 400px;">
            </div>
            <div class="col-lg-6 order-lg-1">
                <h3 class="fw-bold mb-4 text-primary">Pesca Fresca y de Calidad</h3>
                <p class="lead mb-4">Ofrecemos una amplia variedad de productos marinos capturados de manera artesanal y responsable en las costas de Manabí.</p>
                <ul class="list-unstyled fs-5">
                    <li class="mb-3"><i class="bi bi-check-circle-fill text-primary me-2"></i> Pescado fresco (Dorado, Albacora, Picudo)</li>
                    <li class="mb-3"><i class="bi bi-check-circle-fill text-primary me-2"></i> Mariscos (Camarón, Concha, Calamar)</li>
                    <li class="mb-3"><i class="bi bi-check-circle-fill text-primary me-2"></i> Productos procesados artesanalmente</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section id="contacto" class="section contact-section py-5">
    <div class="container">
        <h2 class="section-title text-center text-white mb-5">Contacto</h2>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="card bg-dark text-white border-0 shadow-lg h-100 p-4">
                    <h4 class="mb-4"><i class="bi bi-geo-alt me-2 text-primary"></i>Información de Contacto</h4>
                    <div class="mb-3">
                        <p><i class="bi bi-person-badge me-2 text-primary"></i><strong>Representante:</strong> Walter González Klegan</p>
                        <p><i class="bi bi-telephone me-2 text-primary"></i><strong>Teléfono:</strong> +593 981452439</p>
                        <p><i class="bi bi-envelope me-2 text-primary"></i><strong>Email:</strong> info@asopropesmar.org.ec</p>
                        <p><i class="bi bi-geo-alt me-2 text-primary"></i><strong>Ubicación:</strong> Manta, Manabí, Ecuador</p>
                        <p><i class="bi bi-clock me-2 text-primary"></i><strong>Horario:</strong> Lunes a Viernes 8:00 - 17:00</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card bg-dark text-white border-0 shadow-lg h-100 p-4">
                    <h4 class="mb-4"><i class="bi bi-map me-2 text-primary"></i>Nuestra Ubicación</h4>
                    <div class="map-container rounded overflow-hidden" style="height: 250px;">
                        <iframe src="https://www.openstreetmap.org/export/embed.html?bbox=-80.72%2C-0.96%2C-80.68%2C-0.92&amp;layer=mapnik&amp;marker=-0.95%2C-80.70"
                                width="100%" height="100%" style="border:0;" allowfullscreen loading="lazy"></iframe>
                    </div>
                    <p class="mt-3 text-center mb-0"><small> Puerto de Manta, Manabí - Ecuador</small></p>
                </div>
            </div>
        </div>
    </div>
</section>
