@page "/"

<PageTitle>ASOPROPESMAR - Asociación de Producción Pesquera</PageTitle>

<!-- Hero Section -->
<section id="inicio" class="hero-section">
    <div class="container text-center">
        <h1 class="display-3 fw-bold mb-4 animate__animated animate__fadeInDown">
            Bienvenidos a ASOPROPESMAR
        </h1>
        <p class="lead mb-5 animate__animated animate__fadeInUp animate__delay-1s">
            Asociación de Producción Pesquera Manabí Artesanal<br>
            "Unidos por un mar de oportunidades"
        </p>
        <div class="animate__animated animate__fadeInUp animate__delay-2s">
            <a href="#nosotros" class="btn btn-primary btn-lg me-3 mb-3">Conoce Más</a>
            <a href="#contacto" class="btn btn-outline-light btn-lg mb-3">Contáctanos</a>
        </div>
    </div>
</section>

<!-- Nosotros -->
<section id="nosotros" class="section">
    <div class="container">
        <h2 class="section-title">Sobre Nosotros</h2>
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="position-relative">
                    <img src="asopro.jpeg" alt="Pescadores artesanales" class="img-fluid rounded-4 shadow-lg">
                    <div class="position-absolute bottom-0 end-0 bg-primary text-white p-4 rounded-4 m-3 shadow">
                        <h3 class="fw-bold mb-0">15+</h3>
                        <p class="mb-0">Años de Experiencia</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <h3 class="mb-4">Nuestra Historia y Misión</h3>
                <p class="lead text-muted mb-4">
                    Fundada en el corazón de Manabí, ASOPROPESMAR representa el esfuerzo y la dedicación de cientos de pescadores artesanales ecuatorianos.
                </p>
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-bullseye fs-2 text-primary me-3"></i>
                            <div>
                                <h5>Misión</h5>
                                <p class="text-muted small">Promover el desarrollo sostenible de la pesca artesanal en Manabí.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-eye fs-2 text-primary me-3"></i>
                            <div>
                                <h5>Visión</h5>
                                <p class="text-muted small">Ser la asociación pesquera líder en innovación y sustentabilidad del Ecuador.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Servicios -->
<section id="servicios" class="section bg-light">
    <div class="container">
        <h2 class="section-title">Nuestros Servicios</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card service-card h-100 border-0 p-4">
                    <div class="card-body text-center">
                        <div class="icon-wrapper bg-primary bg-opacity-10 text-primary mb-4 mx-auto rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                            <i class="bi bi-shield-check fs-1"></i>
                        </div>
                        <h4 class="card-title">Asesoría Legal</h4>
                        <p class="card-text text-muted">Acompañamiento en trámites y permisos para nuestros asociados.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card service-card h-100 border-0 p-4">
                    <div class="card-body text-center">
                        <div class="icon-wrapper bg-success bg-opacity-10 text-success mb-4 mx-auto rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                            <i class="bi bi-book fs-1"></i>
                        </div>
                        <h4 class="card-title">Capacitación</h4>
                        <p class="card-text text-muted">Programas de formación en pesca sostenible y seguridad marítima.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card service-card h-100 border-0 p-4">
                    <div class="card-body text-center">
                        <div class="icon-wrapper bg-info bg-opacity-10 text-info mb-4 mx-auto rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                            <i class="bi bi-shop fs-1"></i>
                        </div>
                        <h4 class="card-title">Comercialización</h4>
                        <p class="card-text text-muted">Apoyo en la venta directa de productos pesqueros a mercados justos.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Directiva -->
<section id="directiva" class="section">
    <div class="container">
        <h2 class="section-title">Nuestra Directiva</h2>
        <div class="row g-4 justify-content-center">
            <div class="col-md-4">
                <div class="directive-card card border-0 text-center p-4">
                    <img src="producto.jpg" alt="Presidente" class="rounded-circle mx-auto mb-3 object-fit-cover shadow" style="width: 150px; height: 150px;">
                    <h4>Walter González Klegan</h4>
                    <p class="text-primary fw-bold mb-2">Presidente</p>
                    <p class="text-muted small">Líder comprometido con el desarrollo del sector pesquero artesanal.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Intranet (Dashboard) -->
<section id="intranet" class="section bg-light">
    <div class="container">
        <h2 class="section-title">Portal de Asociados</h2>

        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-people-fill fs-1 mb-3"></i>
                    <div class="stat-number" id="totalMembers">0</div>
                    <p>Total Asociados</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-person-check-fill fs-1 mb-3"></i>
                    <div class="stat-number" id="activeMembers">0</div>
                    <p>Activos</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-person-dash-fill fs-1 mb-3"></i>
                    <div class="stat-number" id="inactiveMembers">0</div>
                    <p>Inactivos</p>
                </div>
            </div>
        </div>

        <div class="db-section">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="mb-0"><i class="bi bi-database me-2"></i>Base de Datos de Asociados</h4>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#memberModal">
                    <i class="bi bi-plus-circle me-1"></i> Nuevo Asociado
                </button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover" id="membersTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th>Tipo</th>
                            <th>Estado</th>
                            <th>Fecha</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="membersTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!-- Contacto -->
<section id="contacto" class="section contact-section">
    <div class="container">
        <h2 class="section-title" style="color: white;">Contacto</h2>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="contact-card">
                    <h4 class="mb-4"><i class="bi bi-geo-alt me-2"></i>Información de Contacto</h4>
                    <div class="mb-3">
                        <p><i class="bi bi-person-badge me-2"></i><strong>Representante:</strong> Walter González Klegan</p>
                        <p><i class="bi bi-telephone me-2"></i><strong>Teléfono:</strong> +593 981452439</p>
                        <p><i class="bi bi-envelope me-2"></i><strong>Email:</strong> info@asopropesmar.org.ec</p>
                        <p><i class="bi bi-geo-alt me-2"></i><strong>Ubicación:</strong> Manta, Manabí, Ecuador</p>
                        <p><i class="bi bi-clock me-2"></i><strong>Horario:</strong> Lunes a Viernes 8:00 - 17:00</p>
                    </div>
                    <div class="mt-4">
                        <a href="#" class="btn btn-outline-light me-2"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="btn btn-outline-light me-2"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="btn btn-outline-light"><i class="bi bi-whatsapp"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="contact-card">
                    <h4 class="mb-4"><i class="bi bi-map me-2"></i>Nuestra Ubicación</h4>
                    <div class="map-container">
                        <iframe src="https://www.openstreetmap.org/export/embed.html?bbox=-80.72%2C-0.96%2C-80.68%2C-0.92&amp;layer=mapnik&amp;marker=-0.95%2C-80.70"
                                width="100%" height="300" style="border:0; border-radius: 15px;" allowfullscreen loading="lazy"></iframe>
                    </div>
                    <p class="mt-3 text-center"><small> Puerto de Manta, Manabí - Ecuador</small></p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modal Nuevo Asociado -->
<div class="modal fade" id="memberModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>Nuevo Asociado</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="memberForm">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Nombres *</label>
                            <input type="text" class="form-control" id="memberFirstName" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Apellidos *</label>
                            <input type="text" class="form-control" id="memberLastName" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email *</label>
                        <input type="email" class="form-control" id="memberEmail" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Teléfono *</label>
                        <input type="tel" class="form-control" id="memberPhone" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tipo</label>
                        <select class="form-select" id="memberType">
                            <option value="pescador">Pescador</option>
                            <option value="acuicultor">Acuicultor</option>
                            <option value="procesador">Procesador</option>
                            <option value="comerciante">Comerciante</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Estado</label>
                        <select class="form-select" id="memberStatus">
                            <option value="activo">Activo</option>
                            <option value="inactivo">Inactivo</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Guardar</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div class="toast-container" id="toastContainer"></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="js/script.js"></script>
