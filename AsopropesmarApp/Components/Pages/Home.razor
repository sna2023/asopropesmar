@page "/"

<PageTitle>ASOPROPESMAR - Asociación de Producción Pesquera Manabí Artesanal</PageTitle>

<!-- Hero Section -->
<section id="inicio" class="hero-section text-center text-white d-flex align-items-center" style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('fondo.jpg') no-repeat center center/cover; min-height: 80vh;">
    <div class="container">
        <h1 class="display-3 fw-bold mb-4 animate__animated animate__fadeInDown">ASOPROPESMAR</h1>
        <p class="lead mb-5 animate__animated animate__fadeInUp">Asociación de Producción Pesquera Manabí Artesanal</p>
        <div class="animate__animated animate__fadeInUp animate__delay-1s">
            <a href="#directorio" class="btn btn-primary btn-lg me-3 mb-3"><i class="bi bi-people-fill me-2"></i>Ver Directorio</a>
            <button class="btn btn-outline-light btn-lg mb-3" data-bs-toggle="modal" data-bs-target="#memberModal">
                <i class="bi bi-person-plus-fill me-2"></i>Únete a Nosotros
            </button>
        </div>
    </div>
</section>

<!-- Nosotros -->
<section id="nosotros" class="section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <img src="asopro.jpeg" alt="Pescadores Artesanales" class="img-fluid rounded-4 shadow-lg">
            </div>
            <div class="col-lg-6">
                <h2 class="section-title">Nuestra Historia</h2>
                <p class="lead text-muted mb-4">Más de 15 años impulsando el desarrollo pesquero en la costa manabita.</p>
                <p>ASOPROPESMAR nació de la unión de familias pescadoras con la visión de mejorar las condiciones de trabajo, proteger nuestros recursos marinos y asegurar un precio justo para nuestros productos.</p>
                <div class="row mt-4">
                    <div class="col-sm-6 mb-3">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-check-circle-fill text-primary fs-3 me-3"></i>
                            <h5 class="mb-0">Pesca Sostenible</h5>
                        </div>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-check-circle-fill text-primary fs-3 me-3"></i>
                            <h5 class="mb-0">Comercio Justo</h5>
                        </div>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-check-circle-fill text-primary fs-3 me-3"></i>
                            <h5 class="mb-0">Apoyo Familiar</h5>
                        </div>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-check-circle-fill text-primary fs-3 me-3"></i>
                            <h5 class="mb-0">Capacitación</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Servicios -->
<section id="servicios" class="section bg-light">
    <div class="container">
        <h2 class="section-title text-center">Nuestros Servicios</h2>
        <div class="row g-4 mt-2">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-4 text-center service-card">
                    <img src="Descarga del Día.jpg" alt="Acopio" class="img-fluid rounded mb-3" style="height: 200px; object-fit: cover;">
                    <h4 class="mb-3">Centro de Acopio</h4>
                    <p class="text-muted">Instalaciones modernas para la recepción, limpieza y almacenamiento en frío de la pesca del día.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-4 text-center service-card">
                    <img src="producto.jpg" alt="Comercialización" class="img-fluid rounded mb-3" style="height: 200px; object-fit: cover;">
                    <h4 class="mb-3">Comercialización</h4>
                    <p class="text-muted">Venta directa a mercados y restaurantes, eliminando intermediarios y garantizando mejores precios.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-4 text-center service-card">
                    <div class="d-flex justify-content-center align-items-center bg-primary text-white rounded mb-3" style="height: 200px; font-size: 5rem;">
                        <i class="bi bi-tools"></i>
                    </div>
                    <h4 class="mb-3">Asistencia Técnica</h4>
                    <p class="text-muted">Mantenimiento de embarcaciones, provisión de artes de pesca y capacitación en nuevas normativas.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Directorio / Dashboard -->
<section id="directorio" class="section dashboard-section">
    <div class="container">
        <h2 class="section-title" style="color: white;">Directorio de Asociados</h2>

        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-people fs-1 mb-3"></i>
                    <div class="stat-number" id="totalMembers">0</div>
                    <p>Total Asociados</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-person-check-fill fs-1 mb-3"></i>
                    <div class="stat-number" id="activeMembers">0</div>
                    <p>Activos</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-person-dash-fill fs-1 mb-3"></i>
                    <div class="stat-number" id="inactiveMembers">0</div>
                    <p>Inactivos</p>
                </div>
            </div>
        </div>

        <div class="db-section">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="mb-0"><i class="bi bi-database me-2"></i>Base de Datos de Asociados</h4>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#memberModal">
                    <i class="bi bi-plus-circle me-1"></i> Nuevo Asociado
                </button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover" id="membersTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th>Tipo</th>
                            <th>Estado</th>
                            <th>Fecha</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="membersTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!-- Contacto -->
<section id="contacto" class="section contact-section">
    <div class="container">
        <h2 class="section-title" style="color: white;">Contacto</h2>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="contact-card">
                    <h4 class="mb-4"><i class="bi bi-geo-alt me-2"></i>Información de Contacto</h4>
                    <div class="mb-3">
                        <p><i class="bi bi-person-badge me-2"></i><strong>Representante:</strong> Walter González Klegan</p>
                        <p><i class="bi bi-telephone me-2"></i><strong>Teléfono:</strong> +593 981452439</p>
                        <p><i class="bi bi-envelope me-2"></i><strong>Email:</strong> info@asopropesmar.org.ec</p>
                        <p><i class="bi bi-geo-alt me-2"></i><strong>Ubicación:</strong> Manta, Manabí, Ecuador</p>
                        <p><i class="bi bi-clock me-2"></i><strong>Horario:</strong> Lunes a Viernes 8:00 - 17:00</p>
                    </div>
                    <div class="mt-4">
                        <a href="#" class="btn btn-outline-light me-2"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="btn btn-outline-light me-2"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="btn btn-outline-light"><i class="bi bi-whatsapp"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="contact-card">
                    <h4 class="mb-4"><i class="bi bi-map me-2"></i>Nuestra Ubicación</h4>
                    <div class="map-container">
                        <iframe src="https://www.openstreetmap.org/export/embed.html?bbox=-80.72%2C-0.96%2C-80.68%2C-0.92&amp;layer=mapnik&amp;marker=-0.95%2C-80.70"
                                width="100%" height="300" style="border:0; border-radius: 15px;" allowfullscreen loading="lazy"></iframe>
                    </div>
                    <p class="mt-3 text-center"><small> Puerto de Manta, Manabí - Ecuador</small></p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modal Nuevo Asociado -->
<div class="modal fade" id="memberModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-dark"><i class="bi bi-person-plus me-2"></i>Nuevo Asociado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-dark">
                <form id="memberForm">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Nombres *</label>
                            <input type="text" class="form-control" id="memberFirstName" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Apellidos *</label>
                            <input type="text" class="form-control" id="memberLastName" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email *</label>
                        <input type="email" class="form-control" id="memberEmail" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Teléfono *</label>
                        <input type="tel" class="form-control" id="memberPhone" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tipo</label>
                        <select class="form-select" id="memberType">
                            <option value="pescador">Pescador</option>
                            <option value="acuicultor">Acuicultor</option>
                            <option value="procesador">Procesador</option>
                            <option value="comerciante">Comerciante</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Estado</label>
                        <select class="form-select" id="memberStatus">
                            <option value="activo">Activo</option>
                            <option value="inactivo">Inactivo</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Guardar</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>
