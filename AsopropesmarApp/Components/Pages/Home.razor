@page "/"
@page "/inicio/"

<PageTitle>ASOPROPESMAR - Asociación de Producción Pesquera Manabí Artesanal</PageTitle>

<!-- Hero Section con peces -->
<section id="inicio" class="hero-section">
    <!-- Peces nadando -->
    <div class="fish" style="top: 15%; animation-duration: 12s; animation-delay: 0s;">
        <span class="iconify" data-icon="noto:fish" style="font-size: 40px; color: #4bcffa;"></span>
    </div>
    <div class="fish" style="top: 35%; animation-duration: 18s; animation-delay: -5s;">
        <span class="iconify" data-icon="noto:fish" style="font-size: 32px; color: #f4d03f;"></span>
    </div>
    <div class="fish" style="top: 55%; animation-duration: 15s; animation-delay: -10s;">
        <span class="iconify" data-icon="noto:fish" style="font-size: 45px; color: #4bcffa;"></span>
    </div>
    <div class="fish" style="top: 75%; animation-duration: 20s; animation-delay: -3s;">
        <span class="iconify" data-icon="noto:fish" style="font-size: 28px; color: #e74c3c;"></span>
    </div>
    <div class="fish" style="top: 25%; animation-duration: 14s; animation-delay: -8s;">
        <span class="iconify" data-icon="noto:fish" style="font-size: 38px; color: #f4d03f;"></span>
    </div>

    <!-- Burbujas -->
    <div class="bubble" style="left: 10%; width: 20px; height: 20px; animation-delay: 0s;"></div>
    <div class="bubble" style="left: 30%; width: 15px; height: 15px; animation-delay: 2s;"></div>
    <div class="bubble" style="left: 50%; width: 25px; height: 25px; animation-delay: 4s;"></div>
    <div class="bubble" style="left: 70%; width: 18px; height: 18px; animation-delay: 1s;"></div>
    <div class="bubble" style="left: 90%; width: 22px; height: 22px; animation-delay: 3s;"></div>

    <div class="container hero-content text-center text-white">
        <h1 class="hero-title mb-4">ASOPROPESMAR</h1>
        <p class="hero-subtitle mb-4">Asociación de Producción Pesquera Manabí Artesanal</p>
        <p class="lead mb-4">Promoviendo la pesca sostenible y el desarrollo comunitario en Manabí, Ecuador</p>
        <div>
            <a href="#nosotros" class="btn btn-primary me-3">Conócenos</a>
            <a href="#contacto" class="btn btn-outline-light">Contáctanos</a>
        </div>
    </div>

    <div class="wave-container">
        <div class="wave" style="height: 150px;"></div>
    </div>
</section>

<!-- Nosotros -->
<section id="nosotros" class="section">
    <div class="container">
        <h2 class="section-title">Sobre Nosotros</h2>
        <div class="row g-4 mb-5">
            <div class="col-md-6">
                <div class="mission-card">
                    <div class="icon-box">
                        <i class="bi bi-bullseye"></i>
                    </div>
                    <h3>Misión</h3>
                    <p>Organizar y representar a los pescadores artesanales de Manabí, promoviendo prácticas pesqueras sostenibles, mejorando las condiciones socioeconómicas de nuestros asociados y fortaleciendo la identidad cultural pesquera de la región.</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="vision-card">
                    <div class="icon-box">
                        <i class="bi bi-eye"></i>
                    </div>
                    <h3>Visión</h3>
                    <p>Ser reconocidos como la asociación pesquera líder en Ecuador por nuestras prácticas responsables, innovación en procesos artesanales y compromiso inquebrantable con el bienestar de nuestras comunidades costeras para el año 2026.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Contacto -->
<section id="contacto" class="section contact-section">
    <div class="container">
        <h2 class="section-title" style="color: white;">Contacto</h2>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="contact-card">
                    <h4 class="mb-4"><i class="bi bi-geo-alt me-2"></i>Información de Contacto</h4>
                    <div class="mb-3">
                        <p><i class="bi bi-person-badge me-2"></i><strong>Representante:</strong> Walter González Klegan</p>
                        <p><i class="bi bi-telephone me-2"></i><strong>Teléfono:</strong> +593 981452439</p>
                        <p><i class="bi bi-envelope me-2"></i><strong>Email:</strong> info@asopropesmar.org.ec</p>
                        <p><i class="bi bi-geo-alt me-2"></i><strong>Ubicación:</strong> Manta, Manabí, Ecuador</p>
                        <p><i class="bi bi-clock me-2"></i><strong>Horario:</strong> Lunes a Viernes 8:00 - 17:00</p>
                    </div>
                    <div class="mt-4">
                        <a href="#" class="btn btn-outline-light me-2"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="btn btn-outline-light me-2"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="btn btn-outline-light"><i class="bi bi-whatsapp"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="contact-card">
                    <h4 class="mb-4"><i class="bi bi-map me-2"></i>Nuestra Ubicación</h4>
                    <div class="map-container">
                        <iframe src="https://www.openstreetmap.org/export/embed.html?bbox=-80.72%2C-0.96%2C-80.68%2C-0.92&amp;layer=mapnik&amp;marker=-0.95%2C-80.70"
                                width="100%" height="300" style="border:0; border-radius: 15px;" allowfullscreen loading="lazy"></iframe>
                    </div>
                    <p class="mt-3 text-center"><small> Puerto de Manta, Manabí - Ecuador</small></p>
                </div>
            </div>
        </div>
    </div>
</section>
