@page "/inicio"



    <!-- Hero Section con peces -->
    <section id="inicio" class="hero-section">
        <!-- Peces nadando -->

        <div class="fish" style="top: 15%; animation-duration: 12s; animation-delay: 0s;">
            <span class="iconify" data-icon="noto:fish" style="font-size: 40px; color: #4bcffa;"></span>
        </div>
        <div class="fish" style="top: 35%; animation-duration: 18s; animation-delay: -5s;">
            <span class="iconify" data-icon="noto:fish" style="font-size: 32px; color: #f4d03f;"></span>
        </div>
        <div class="fish" style="top: 55%; animation-duration: 15s; animation-delay: -10s;">
            <span class="iconify" data-icon="noto:fish" style="font-size: 45px; color: #4bcffa;"></span>
        </div>
        <div class="fish" style="top: 75%; animation-duration: 20s; animation-delay: -3s;">
            <span class="iconify" data-icon="noto:fish" style="font-size: 28px; color: #e74c3c;"></span>
        </div>
        <div class="fish" style="top: 25%; animation-duration: 14s; animation-delay: -8s;">
            <span class="iconify" data-icon="noto:fish" style="font-size: 38px; color: #f4d03f;"></span>
        </div>

        <!-- Burbujas -->
        <div class="bubble" style="left: 10%; width: 20px; height: 20px; animation-delay: 0s;"></div>
        <div class="bubble" style="left: 30%; width: 15px; height: 15px; animation-delay: 2s;"></div>
        <div class="bubble" style="left: 50%; width: 25px; height: 25px; animation-delay: 4s;"></div>
        <div class="bubble" style="left: 70%; width: 18px; height: 18px; animation-delay: 1s;"></div>
        <div class="bubble" style="left: 90%; width: 22px; height: 22px; animation-delay: 3s;"></div>

        <div class="container hero-content text-center text-white">
            <h1 class="hero-title mb-4">ASOPROPESMAR</h1>
            <p class="hero-subtitle mb-4">Asociación de Producción Pesquera Manabí Artesanal</p>
            <p class="lead mb-4">Promoviendo la pesca sostenible y el desarrollo comunitario en Manabí, Ecuador</p>
            <div>
                <a href="#nosotros" class="btn btn-primary me-3">Conócenos</a>
                <a href="#contacto" class="btn btn-outline-light">Contáctanos</a>
            </div>
        </div>

        <div class="wave-container">
            <div class="wave" style="height: 150px;"></div>
        </div>
    </section>

    <!-- Nosotros -->
    <section id="nosotros" class="section">
        <div class="container">
            <h2 class="section-title">Sobre Nosotros</h2>
            <div class="row g-4 mb-5">
                <div class="col-md-6">
                    <div class="mission-card">
                        <div class="icon-box">
                            <i class="bi bi-bullseye"></i>
                        </div>
                        <h3>Misión</h3>
                        <p>Organizar y representar a los pescadores artesanales de Manabí, promoviendo prácticas pesqueras sostenibles, mejorando las condiciones socioeconómicas de nuestros asociados y fortaleciendo la identidad cultural pesquera de la región.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="vision-card">
                        <div class="icon-box">
                            <i class="bi bi-eye"></i>
                        </div>
                        <h3>Visión</h3>
                        <p>Ser la asociación pesquera artesanal líder en Ecuador, reconocida por su compromiso con la sostenibilidad, la innovación en la gestión pesquera y la mejora continua de la calidad de vida de las comunidades pesqueras de Manabí.</p>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-md-3">
                    <div class="stat-card">
                        <i class="bi bi-people-fill fs-1 mb-3"></i>
                        <div class="stat-number">200+</div>
                        <p>Asociados</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <i class="bi bi-geo-alt-fill fs-1 mb-3"></i>
                        <div class="stat-number">1</div>
                        <p>Ubicación</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <i class="bi bi-calendar-check fs-1 mb-3"></i>
                        <div class="stat-number">15+</div>
                        <p>Años Experiencia</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <i class="bi bi-award-fill fs-1 mb-3"></i>
                        <div class="stat-number">50+</div>
                        <p>Proyectos</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Servicios -->
    <section id="servicios" class="section bg-light">
        <div class="container">
            <h2 class="section-title">Servicios y Actividades</h2>
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="service-card">
                        <div class="service-header">
                            <i class="bi bi-book-fill fs-3"></i>
                            <h5 class="mt-2">Capacitación Técnica</h5>
                        </div>
                        <div class="service-body">
                            <p class="small">Técnicas de pesca sostenible, seguridad marítima, manejo post-cosecha y conservación.</p>
                            <ul class="service-list">
                                <li>Buenas prácticas pesqueras</li>
                                <li>Seguridad en el mar</li>
                                <li>Manejo de equipos</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="service-card">
                        <div class="service-header">
                            <i class="bi bi-file-text-fill fs-3"></i>
                            <h5 class="mt-2">Asesoría Legal</h5>
                        </div>
                        <div class="service-body">
                            <p class="small">Trámites legales, permisos de pesca, formalización y financiamiento.</p>
                            <ul class="service-list">
                                <li>Licencias y permisos</li>
                                <li>Formalización empresarial</li>
                                <li>Créditos y subsidios</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="service-card">
                        <div class="service-header">
                            <i class="bi bi-cart-fill fs-3"></i>
                            <h5 class="mt-2">Comercialización</h5>
                        </div>
                        <div class="service-body">
                            <p class="small">Venta directa, ferias y mercados especializados.</p>
                            <ul class="service-list">
                                <li>Canales de venta</li>
                                <li>Ferias locales y nacionales</li>
                                <li>Mercados sostenibles</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="service-card">
                        <div class="service-header">
                            <i class="bi bi-tree-fill fs-3"></i>
                            <h5 class="mt-2">Gestión Ambiental</h5>
                        </div>
                        <div class="service-body">
                            <p class="small">Pesca responsable y conservación marina.</p>
                            <ul class="service-list">
                                <li>Pesca responsable</li>
                                <li>Monitoreo de recursos</li>
                                <li>Proyectos de conservación</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Galería -->
    <section id="galeria" class="section gallery-section">
        <div class="container">
            <h2 class="section-title gallery-title">Galería</h2>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="gallery-item">
                        <img src="https://images.unsplash.com/photo-1544551763-46a013bb70d5?w=600&h=400&fit=crop" alt="Pesca artesanal">
                        <div class="gallery-overlay">
                            <h5>Embarcaciones Artesanales</h5>
                            <p>Traditional fishing boats in Manta</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="gallery-item">
                        <img src="Descarga del Día.jpg" alt="Descarga del Día">
                        <div class="gallery-overlay">
                            <h5>Descarga del Día</h5>
                            <p>Fresh catch from the Pacific</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="gallery-item">
                        <img src="producto.jpg" alt="Productos del Mar">
                        <div class="gallery-overlay">
                            <h5>Productos del Mar</h5>
                            <p>Variety of seafood from Manabí</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="gallery-item">
                        <img src="https://images.unsplash.com/photo-1569263979104-865ab7dd8d17?w=600&h=400&fit=crop" alt="Puerto">
                        <div class="gallery-overlay">
                            <h5>Puerto de Manta</h5>
                            <p>Harbor activity</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="gallery-item">
                        <img src="https://images.unsplash.com/photo-1518837695005-2083093ee35b?w=600&h=400&fit=crop" alt="Océano">
                        <div class="gallery-overlay">
                            <h5>Nuestras Aguas</h5>
                            <p>Pacific Ocean waters</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="gallery-item">
                        <img src="https://images.unsplash.com/photo-1523676167721-a48d50a7f7c4?w=600&h=400&fit=crop" alt="Barcos">
                        <div class="gallery-overlay">
                            <h5>Flota Pesquera</h5>
                            <p>Fishing fleet at sea</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Asociados con Base de Datos -->
    <section id="asociados" class="section">
        <div class="container">
            <h2 class="section-title">Gestión de Asociados</h2>
            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <div class="stat-card">
                        <i class="bi bi-people-fill fs-1 mb-3"></i>
                        <div class="stat-number" id="totalMembers">0</div>
                        <p>Total Asociados</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-card">
                        <i class="bi bi-person-check-fill fs-1 mb-3"></i>
                        <div class="stat-number" id="activeMembers">0</div>
                        <p>Activos</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-card">
                        <i class="bi bi-person-dash-fill fs-1 mb-3"></i>
                        <div class="stat-number" id="inactiveMembers">0</div>
                        <p>Inactivos</p>
                    </div>
                </div>
            </div>

            <div class="db-section">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="mb-0"><i class="bi bi-database me-2"></i>Base de Datos de Asociados</h4>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#memberModal">
                        <i class="bi bi-plus-circle me-1"></i> Nuevo Asociado
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover" id="membersTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Email</th>
                                <th>Teléfono</th>
                                <th>Tipo</th>
                                <th>Estado</th>
                                <th>Fecha</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="membersTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>

    <!-- Contacto -->
    <section id="contacto" class="section contact-section">
        <div class="container">
            <h2 class="section-title" style="color: white;">Contacto</h2>
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="contact-card">
                        <h4 class="mb-4"><i class="bi bi-geo-alt me-2"></i>Información de Contacto</h4>
                        <div class="mb-3">
                            <p><i class="bi bi-person-badge me-2"></i><strong>Representante:</strong> Walter González Klegan</p>
                            <p><i class="bi bi-telephone me-2"></i><strong>Teléfono:</strong> +593 981452439</p>
                            <p><i class="bi bi-envelope me-2"></i><strong>Email:</strong> info@asopropesmar.org.ec</p>
                            <p><i class="bi bi-geo-alt me-2"></i><strong>Ubicación:</strong> Manta, Manabí, Ecuador</p>
                            <p><i class="bi bi-clock me-2"></i><strong>Horario:</strong> Lunes a Viernes 8:00 - 17:00</p>
                        </div>
                        <div class="mt-4">
                            <a href="#" class="btn btn-outline-light me-2"><i class="bi bi-facebook"></i></a>
                            <a href="#" class="btn btn-outline-light me-2"><i class="bi bi-instagram"></i></a>
                            <a href="#" class="btn btn-outline-light"><i class="bi bi-whatsapp"></i></a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="contact-card">
                        <h4 class="mb-4"><i class="bi bi-map me-2"></i>Nuestra Ubicación</h4>
                        <div class="map-container">
                            <iframe src="https://www.openstreetmap.org/export/embed.html?bbox=-80.72%2C-0.96%2C-80.68%2C-0.92&amp;layer=mapnik&amp;marker=-0.95%2C-80.70"
                                    width="100%" height="300" style="border:0; border-radius: 15px;" allowfullscreen loading="lazy"></iframe>
                        </div>
                        <p class="mt-3 text-center"><small> Puerto de Manta, Manabí - Ecuador</small></p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Modal Nuevo Asociado -->
    <div class="modal fade" id="memberModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>Nuevo Asociado</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="memberForm">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nombres *</label>
                                <input type="text" class="form-control" id="memberFirstName" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Apellidos *</label>
                                <input type="text" class="form-control" id="memberLastName" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email *</label>
                            <input type="email" class="form-control" id="memberEmail" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Teléfono *</label>
                            <input type="tel" class="form-control" id="memberPhone" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Tipo</label>
                            <select class="form-select" id="memberType">
                                <option value="pescador">Pescador</option>
                                <option value="acuicultor">Acuicultor</option>
                                <option value="procesador">Procesador</option>
                                <option value="comerciante">Comerciante</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Estado</label>
                            <select class="form-select" id="memberStatus">
                                <option value="activo">Activo</option>
                                <option value="inactivo">Inactivo</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Guardar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
