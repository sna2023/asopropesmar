@inherits LayoutComponentBase
@inject NavigationManager Navigation

<AuthorizeView>
    <NotAuthorized>
        @Body
    </NotAuthorized>
    <Authorized>
        @Body
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool IsLoggedOutPage => Navigation.ToBaseRelativePath(Navigation.Uri).Equals("Cuenta/Autenticacion/LoggedOut", StringComparison.OrdinalIgnoreCase);
}
