@inherits LayoutComponentBase
@inject NavigationManager _navigation
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

<AuthorizeView>
    <NotAuthorized>
        @Body
    </NotAuthorized>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4">
                    <a href="/Cuenta/Autenticacion/Logout" data-enhance-nav="false">Cerrar Sesión</a>
                    <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>

        <div id="blazor-error-ui">
            An unhandled error has occurred.
            <a href="" class="reload">Reload</a>
            <a class="dismiss">🗙</a>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    [Inject]
    private IHttpContextAccessor? _contextAccessor { get; set; }

    protected async override Task OnInitializedAsync()
    {
        if (AuthStat != null)
        {
            var authState = await AuthStat;
            var user = authState?.User;
            if (user is null || user.Identity is null || !user.Identity.IsAuthenticated)
            {
                var context = _contextAccessor?.HttpContext;
                if (context?.Request.Path != AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.LoggedOut)
                {
                    _navigation.NavigateTo(AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.LoggedOut, false, true);
                }
            }
        }
    }
}
