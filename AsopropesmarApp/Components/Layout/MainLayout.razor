@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<AuthorizeView>
    <NotAuthorized>
        @Body
    </NotAuthorized>
    <Authorized>
        <div>
            <!-- We will let the Home component handle its own layout/nav for now,
                 or we could extract the Nav here. The user provided an index.html
                 where the nav is inside the body. For simplicity, we just render @Body
                 and let the Home.razor have the full page markup. -->
            @Body
        </div>

        <div id="blazor-error-ui">
            An unhandled error has occurred.
            <a href="" class="reload">Reload</a>
            <a class="dismiss">🗙</a>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStat != null)
        {
            var user = (await AuthStat).User;
            if (user is null || user.Identity is null || !user.Identity.IsAuthenticated)
            {
                var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
                if (!currentPath.Contains(AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.LoggedOut.TrimStart('/')))
                {
                    NavigationManager.NavigateTo(AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.LoggedOut, false, true);
                }
            }
        }
    }
}
