@inherits LayoutComponentBase
@inject NavigationManager _navigation

<AuthorizeView>
    <NotAuthorized>
        <div class="page">
            <main>
                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>
    </NotAuthorized>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4">
                    <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
                    <a href="/Cuenta/Autenticacion/Logout" class="ms-3">Cerrar Sesión</a>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    protected async override Task OnInitializedAsync()
    {
        var user = (await AuthStat!)?.User;
        if (user is null || user.Identity is null || !user.Identity.IsAuthenticated)
        {
            var relativePath = "/" + _navigation.ToBaseRelativePath(_navigation.Uri);
            if (relativePath != Helpers.Route.Cuenta.Autenticacion.LoggedOut && relativePath != Helpers.Route.Cuenta.Autenticacion.Login)
            {
                _navigation.NavigateTo(Helpers.Route.Cuenta.Autenticacion.LoggedOut, false, true);
            }
        }
    }
}
