@inherits LayoutComponentBase
@inject NavigationManager _navigation

<AuthorizeView>
    <NotAuthorized>
        @{
            var isLoggedOutPath = _navigation.ToBaseRelativePath(_navigation.Uri).Equals("Cuenta/Autenticacion/LoggedOut", StringComparison.OrdinalIgnoreCase);
            if (!isLoggedOutPath)
            {
                _navigation.NavigateTo("/Cuenta/Autenticacion/LoggedOut", false, true);
            }
        }
        @Body
    </NotAuthorized>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4">
                    <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
                    <a href="/Cuenta/Autenticacion/Logout" data-enhance-nav="false" class="ms-3">Cerrar Sesión</a>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>

        <div id="blazor-error-ui" data-nosnippet>
            An unhandled error has occurred.
            <a href="." class="reload">Reload</a>
            <span class="dismiss">🗙</span>
        </div>
    </Authorized>
</AuthorizeView>
