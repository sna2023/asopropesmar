@inherits LayoutComponentBase
@inject NavigationManager _navigation

<AuthorizeView>
    <NotAuthorized>
        @Body
    </NotAuthorized>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4">
                    <a href="/Cuenta/Autenticacion/Logout" data-enhance-nav="false">Cerrar Sesión</a>
                    <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>

        <div id="blazor-error-ui">
            An unhandled error has occurred.
            <a href="" class="reload">Reload</a>
            <a class="dismiss">🗙</a>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStat!)?.User;
        if (user is null || user.Identity is null || !user.Identity.IsAuthenticated)
        {
            var currentPath = new Uri(_navigation.Uri).AbsolutePath;
            var loggedOutPath = Helpers.Route.Cuenta.Autenticacion.LoggedOut;
            if (!currentPath.Equals(loggedOutPath, StringComparison.OrdinalIgnoreCase))
            {
                _navigation.NavigateTo(loggedOutPath, false, true);
            }
        }
    }
}
