@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<AuthorizeView>
    <NotAuthorized>
        <!-- Cuando no está autenticado solo se muestra el body (por ejemplo, la página LoggedOut) -->
        <main>
            @Body
        </main>
    </NotAuthorized>

    <Authorized>
        <div class="page">
            <!-- Navegación -->
            <nav class="navbar navbar-expand-lg sticky-top" id="navbar">
                <div class="container">
                    <a class="navbar-brand" href="#">
                        <img src="asopro.jpeg" alt="ASOPROPESMAR" height="50" class="me-2">
                    </a>
                    <button class="navbar-toggler bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navMenu">
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item"><a class="nav-link" href="#inicio">Inicio</a></li>
                            <li class="nav-item"><a class="nav-link" href="#nosotros">Nosotros</a></li>
                            <li class="nav-item"><a class="nav-link" href="#servicios">Servicios</a></li>
                            <li class="nav-item"><a class="nav-link" href="#galeria">Galería</a></li>
                            <li class="nav-item"><a class="nav-link" href="#asociados">Asociados</a></li>
                            <li class="nav-item"><a class="nav-link" href="#contacto">Contacto</a></li>
                            <li class="nav-item ms-3">
                                <a class="btn login-btn" href="/Cuenta/Autenticacion/Logout" data-enhance-nav="false">
                                    <i class="bi bi-person-circle me-1"></i> Cerrar Sesión
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

            <main>
                @Body
            </main>

            <!-- Contacto -->
            <section id="contacto" class="section contact-section">
                <div class="container">
                    <h2 class="section-title" style="color: white;">Contacto</h2>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="contact-card">
                                <h4 class="mb-4"><i class="bi bi-geo-alt me-2"></i>Información de Contacto</h4>
                                <div class="mb-3">
                                    <p><i class="bi bi-person-badge me-2"></i><strong>Representante:</strong> Walter González Klegan</p>
                                    <p><i class="bi bi-telephone me-2"></i><strong>Teléfono:</strong> +593 981452439</p>
                                    <p><i class="bi bi-envelope me-2"></i><strong>Email:</strong> info@asopropesmar.org.ec</p>
                                    <p><i class="bi bi-geo-alt me-2"></i><strong>Ubicación:</strong> Manta, Manabí, Ecuador</p>
                                    <p><i class="bi bi-clock me-2"></i><strong>Horario:</strong> Lunes a Viernes 8:00 - 17:00</p>
                                </div>
                                <div class="mt-4">
                                    <a href="#" class="btn btn-outline-light me-2"><i class="bi bi-facebook"></i></a>
                                    <a href="#" class="btn btn-outline-light me-2"><i class="bi bi-instagram"></i></a>
                                    <a href="#" class="btn btn-outline-light"><i class="bi bi-whatsapp"></i></a>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="contact-card">
                                <h4 class="mb-4"><i class="bi bi-map me-2"></i>Nuestra Ubicación</h4>
                                <div class="map-container">
                                    <iframe src="https://www.openstreetmap.org/export/embed.html?bbox=-80.72%2C-0.96%2C-80.68%2C-0.92&amp;layer=mapnik&amp;marker=-0.95%2C-80.70"
                                            width="100%" height="300" style="border:0; border-radius: 15px;" allowfullscreen loading="lazy"></iframe>
                                </div>
                                <p class="mt-3 text-center"><small> Puerto de Manta, Manabí - Ecuador</small></p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Footer -->
            <footer class="footer text-center">
                <div class="container">
                    <div class="row">
                        <div class="col-md-4 mb-4">
                            <h5>ASOPROPESMAR</h5>
                            <p class="small">Asociación de Producción Pesquera Manabí Artesanal</p>
                        </div>
                        <div class="col-md-4 mb-4">
                            <h5>Enlaces</h5>
                            <ul class="list-unstyled">
                                <li><a href="#inicio" class="text-white-50 text-decoration-none">Inicio</a></li>
                                <li><a href="#nosotros" class="text-white-50 text-decoration-none">Nosotros</a></li>
                                <li><a href="#servicios" class="text-white-50 text-decoration-none">Servicios</a></li>
                            </ul>
                        </div>
                        <div class="col-md-4 mb-4">
                            <h5>Datos 2026</h5>
                            <p class="small">Más de 200 pescadores asociados</p>
                            <p class="small">15+ años de experiencia</p>
                        </div>
                    </div>
                    <hr style="border-color: rgba(255,255,255,0.2);">
                    <p>&copy; 2026 ASOPROPESMAR. Todos los derechos reservados.</p>
                </div>
            </footer>
        </div>
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    protected async override Task OnInitializedAsync()
    {
        if (AuthStat != null)
        {
            var user = (await AuthStat)?.User;
            if (user is null || user.Identity is null || !user.Identity.IsAuthenticated)
            {
                var uri = new Uri(NavigationManager.Uri);
                string relativePath = NavigationManager.ToBaseRelativePath(uri.ToString());
                if (!relativePath.Equals("Cuenta/Autenticacion/LoggedOut", StringComparison.OrdinalIgnoreCase))
                {
                    NavigationManager.NavigateTo("/Cuenta/Autenticacion/LoggedOut", false, true);
                }
            }
        }
    }
}
