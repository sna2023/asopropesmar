@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<div class="page">
    <AuthorizeView>
        <Authorized>
            <main style="width: 100%; padding: 0;">
                <div class="top-row px-4 d-flex justify-content-end" style="background: #0d6efd; color: white;">
                    <span class="me-3">Bienvenido, @context.User.Identity?.Name</span>
                    <a href="/Cuenta/Autenticacion/Logout" class="text-white text-decoration-none fw-bold"><i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión</a>
                </div>

                <article class="content" style="padding: 0;">
                    @Body
                </article>
            </main>
        </Authorized>
        <NotAuthorized>
            <main style="width: 100%; padding: 0;">
                <article class="content text-center" style="padding: 0; min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; background-color: #f8f9fa;">
                    @if (IsLoggedOutPage)
                    {
                        @Body
                    }
                    else
                    {
                        <div class="card shadow-lg p-5" style="border-radius: 15px;">
                            <h2 class="mb-4">ASOPROPESMAR</h2>
                            <h4 class="mb-3">Acceso Denegado</h4>
                            <p class="text-muted mb-4">Debes iniciar sesión para acceder al sistema.</p>
                            <a href="/Cuenta/Autenticacion/Login" class="btn btn-primary btn-lg"><i class="bi bi-box-arrow-in-right me-2"></i> Iniciar Sesión</a>
                        </div>
                    }
                </article>
            </main>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    private bool IsLoggedOutPage => NavigationManager.Uri.EndsWith("/Cuenta/Autenticacion/LoggedOut", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        if (AuthStat is not null)
        {
            var authState = await AuthStat;
            var user = authState.User;
            if (user is null || user.Identity is null || !user.Identity.IsAuthenticated)
            {
                var uri = new Uri(NavigationManager.Uri);
                if (!uri.AbsolutePath.Equals("/Cuenta/Autenticacion/LoggedOut", StringComparison.OrdinalIgnoreCase) &&
                    !uri.AbsolutePath.Equals("/Cuenta/Autenticacion/Login", StringComparison.OrdinalIgnoreCase))
                {
                    NavigationManager.NavigateTo("/Cuenta/Autenticacion/LoggedOut", forceLoad: false, replace: true);
                }
            }
        }
    }
}
