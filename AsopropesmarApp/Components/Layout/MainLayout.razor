@inherits LayoutComponentBase

<AuthorizeView>
    <NotAuthorized>
        <div class="page">
            <main>
                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>
    </NotAuthorized>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4">
                    <a href="/Cuenta/Autenticacion/Logout" data-enhance-nav="false">Cerrar Sesión</a>
                    <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    [Inject]
    private NavigationManager _navigation { get; set; } = default!;

    [Inject]
    private Microsoft.AspNetCore.Http.IHttpContextAccessor _context { get; set; } = default!;

    protected async override Task OnInitializedAsync()
    {
        var user = AuthStat is not null ? (await AuthStat).User : null;
        if (user is null || user.Identity is null || !user.Identity.IsAuthenticated)
        {
            if (_context?.HttpContext?.Request.Path != AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.LoggedOut)
                _navigation.NavigateTo(AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.LoggedOut, false, true);
        }
    }
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
