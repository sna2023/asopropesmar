@inherits LayoutComponentBase
@inject NavigationManager _navigation

<AuthorizeView>
    <NotAuthorized>
        @Body
    </NotAuthorized>
    <Authorized>
        <div class="page">
            <main>
                <div class="top-row px-4">
                    <a href="/Cuenta/Autenticacion/Logout" data-enhance-nav="false">Cerrar Sesión</a>
                </div>
                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStat is not null)
        {
            var authState = await AuthStat;
            var user = authState?.User;
            if (user is null || user.Identity is null || !user.Identity.IsAuthenticated)
            {
                var relativePath = _navigation.ToBaseRelativePath(_navigation.Uri);
                if (!relativePath.StartsWith("Cuenta/Autenticacion/LoggedOut", StringComparison.OrdinalIgnoreCase))
                {
                    _navigation.NavigateTo(Helpers.Route.Cuenta.Autenticacion.LoggedOut, forceLoad: false);
                }
            }
        }
    }
}
