@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <a href="/Cuenta/Autenticacion/Logout">Cerrar Sesión</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/Cuenta/Autenticacion/Login">Iniciar Sesión</a>
                </NotAuthorized>
            </AuthorizeView>
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
