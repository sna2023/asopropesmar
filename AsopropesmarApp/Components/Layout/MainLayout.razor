@inherits LayoutComponentBase
@inject NavigationManager _navigation

<div class="page">
    <AuthorizeView>
        <Authorized>
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4">
                    <span>Bienvenido, @context.User.Identity?.Name</span>
                    <a href="/Cuenta/Autenticacion/Logout" class="ms-3" data-enhance-nav="false">Cerrar Sesión</a>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </Authorized>
        <NotAuthorized>
            <main>
                <article class="content px-4">
                    @Body
                </article>
            </main>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    protected async override Task OnInitializedAsync()
    {
        if (AuthStat != null)
        {
            var user = (await AuthStat)?.User;
            if (user is null || user.Identity is null || !user.Identity.IsAuthenticated)
            {
                // ToBaseRelativePath returns string without leading slash
                var currentPath = "/" + _navigation.ToBaseRelativePath(_navigation.Uri);
                if (currentPath != AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.LoggedOut)
                {
                    _navigation.NavigateTo(AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.LoggedOut, forceLoad: true);
                }
            }
        }
    }
}
