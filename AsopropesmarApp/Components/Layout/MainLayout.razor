@inherits LayoutComponentBase
@inject NavigationManager Navigation

<AuthorizeView>
    <NotAuthorized>
        <div class="unauthorized-layout">
            @Body
        </div>
    </NotAuthorized>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4">
                    <a href="/Cuenta/Autenticacion/Logout" data-enhance-nav="false">Cerrar Sesión</a>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>

        <div id="blazor-error-ui">
            An unhandled error has occurred.
            <a href="" class="reload">Reload</a>
            <a class="dismiss">🗙</a>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    [Inject]
    private IHttpContextAccessor? _context { get; set; }

    protected async override Task OnInitializedAsync()
    {
        if (AuthStat != null)
        {
            var user = (await AuthStat)?.User;
            if (user is null || user.Identity is null || !user.Identity.IsAuthenticated)
            {
                var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
                var isLoggedOutPage = string.Equals("/" + relativePath, AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.LoggedOut, StringComparison.OrdinalIgnoreCase);

                if (!isLoggedOutPage)
                {
                    Navigation.NavigateTo(AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.LoggedOut, forceLoad: true);
                }
            }
        }
    }
}
