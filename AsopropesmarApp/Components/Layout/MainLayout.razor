@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<AuthorizeView>
    <NotAuthorized>
        @if (!IsLoggedOutPage())
        {
            <div class="container mt-5 text-center">
                <h3>No tienes autorización para ver esta página</h3>
                <a href="/Cuenta/Autenticacion/Login" data-enhance-nav="false" class="btn btn-primary mt-3">Iniciar Sesión</a>
            </div>
        }
        else
        {
            @Body
        }
    </NotAuthorized>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4">
                    <span>Bienvenido, @context.User.Identity?.Name</span>
                    <a href="/Cuenta/Autenticacion/Logout" data-enhance-nav="false" class="btn btn-sm btn-outline-danger ms-3">Cerrar Sesión</a>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStat is not null)
        {
            var user = (await AuthStat).User;
            if (user is null || user.Identity is null || !user.Identity.IsAuthenticated)
            {
                if (!IsLoggedOutPage())
                {
                    NavigationManager.NavigateTo(AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.LoggedOut, false, true);
                }
            }
        }
    }

    private bool IsLoggedOutPage()
    {
        var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var loggedOutPath = AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.LoggedOut.TrimStart('/');
        return currentPath.Equals(loggedOutPath, StringComparison.OrdinalIgnoreCase);
    }
}
