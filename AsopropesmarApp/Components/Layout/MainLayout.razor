@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web

<div class="page">
    <AuthorizeView>
        <Authorized>
            <main>
                <nav class="navbar navbar-expand-lg sticky-top" id="navbar">
                    <div class="container">
                        <a class="navbar-brand" href="#">
                            <img src="asopro.jpeg" alt="ASOPROPESMAR" height="50" class="me-2">
                        </a>
                        <button class="navbar-toggler bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="collapse navbar-collapse" id="navMenu">
                            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                                <li class="nav-item"><a class="nav-link text-white" href="#inicio">Inicio</a></li>
                                <li class="nav-item"><a class="nav-link text-white" href="#nosotros">Nosotros</a></li>
                                <li class="nav-item"><a class="nav-link text-white" href="#servicios">Servicios</a></li>
                                <li class="nav-item"><a class="nav-link text-white" href="#asociados">Asociados</a></li>
                                <li class="nav-item"><a class="nav-link text-white" href="#contacto">Contacto</a></li>
                            </ul>
                            <div class="ms-3 d-flex align-items-center">
                                <span class="text-white me-3 d-none d-lg-block"><i class="bi bi-person-circle me-1"></i> Hola, @context.User.Identity?.Name</span>
                                <a href="@AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.Logout" class="btn btn-danger btn-sm" data-enhance-nav="false">Cerrar Sesión</a>
                            </div>
                        </div>
                    </div>
                </nav>
                <article class="content px-4">
                    @Body
                </article>
            </main>
        </Authorized>
        <NotAuthorized>
            <article class="content px-4">
                @Body
            </article>
        </NotAuthorized>
    </AuthorizeView>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
