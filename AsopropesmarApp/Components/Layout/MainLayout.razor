@inherits LayoutComponentBase
@inject NavigationManager _navigation

<AuthorizeView>
    <NotAuthorized>
        <div class="page">
            <main>
                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>
    </NotAuthorized>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4">
                    <a href="/Cuenta/Autenticacion/Logout" data-enhance-nav="false">Cerrar Sesión</a>
                    <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await (AuthStat ?? Task.FromResult<AuthenticationState>(new AuthenticationState(new System.Security.Claims.ClaimsPrincipal(new System.Security.Claims.ClaimsIdentity()))));
        var user = authState?.User;
        if (user is null || user.Identity is null || !user.Identity.IsAuthenticated)
        {
            var basePath = _navigation.ToBaseRelativePath(_navigation.Uri);
            var isLoggedOutPath = ("/" + basePath) == AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.LoggedOut;
            if (!isLoggedOutPath)
            {
                _navigation.NavigateTo(AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.LoggedOut, forceLoad: true);
            }
        }
    }
}
