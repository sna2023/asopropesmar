@inherits LayoutComponentBase
@inject NavigationManager _navigation

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ASOPROPESMAR - Asociación de Producción Pesquera Manabí Artesanal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
    <link rel="stylesheet" href="css/styles.css">
    <HeadOutlet />
</head>
<body data-bs-spy="scroll" data-bs-target="#navbar">
    <AuthorizeView>
        <NotAuthorized>
            @Body
        </NotAuthorized>
        <Authorized>
            <!-- Navegación -->
            <nav class="navbar navbar-expand-lg sticky-top" id="navbar">
                <div class="container">
                    <a class="navbar-brand" href="#">
                        <img src="asopro.jpeg" alt="ASOPROPESMAR" height="50" class="me-2">
                    </a>
                    <button class="navbar-toggler bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navMenu">
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item"><a class="nav-link" href="#inicio">Inicio</a></li>
                            <li class="nav-item"><a class="nav-link" href="#nosotros">Nosotros</a></li>
                            <li class="nav-item"><a class="nav-link" href="#servicios">Servicios</a></li>
                            <li class="nav-item"><a class="nav-link" href="#galeria">Galería</a></li>
                            <li class="nav-item"><a class="nav-link" href="#asociados">Asociados</a></li>
                            <li class="nav-item"><a class="nav-link" href="#contacto">Contacto</a></li>
                            <li class="nav-item ms-3">
                                <a href="/Cuenta/Autenticacion/Logout" class="btn login-btn" data-enhance-nav="false">
                                    <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

            @Body

            <!-- Footer -->
            <footer class="footer text-center">
                <div class="container">
                    <div class="row">
                        <div class="col-md-4 mb-4">
                            <h5>ASOPROPESMAR</h5>
                            <p class="small">Asociación de Producción Pesquera Manabí Artesanal</p>
                        </div>
                        <div class="col-md-4 mb-4">
                            <h5>Enlaces</h5>
                            <ul class="list-unstyled">
                                <li><a href="#inicio" class="text-white-50 text-decoration-none">Inicio</a></li>
                                <li><a href="#nosotros" class="text-white-50 text-decoration-none">Nosotros</a></li>
                                <li><a href="#servicios" class="text-white-50 text-decoration-none">Servicios</a></li>
                            </ul>
                        </div>
                        <div class="col-md-4 mb-4">
                            <h5>Datos 2026</h5>
                            <p class="small">Más de 200 pescadores asociados</p>
                            <p class="small">15+ años de experiencia</p>
                        </div>
                    </div>
                    <hr style="border-color: rgba(255,255,255,0.2);">
                    <p>&copy; 2026 ASOPROPESMAR. Todos los derechos reservados.</p>
                </div>
            </footer>
        </Authorized>
    </AuthorizeView>

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="js/script.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStat { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStat is not null)
        {
            var user = (await AuthStat).User;
            if (user is null || user.Identity is null || !user.Identity.IsAuthenticated)
            {
                var relativePath = "/" + _navigation.ToBaseRelativePath(_navigation.Uri);
                if (relativePath != Route.Cuenta.Autenticacion.LoggedOut)
                {
                    _navigation.NavigateTo(Route.Cuenta.Autenticacion.LoggedOut, false, true);
                }
            }
        }
    }
}
