@inherits LayoutComponentBase
@inject NavigationManager _navigation

<AuthorizeView>
    <NotAuthorized>
        @Body
    </NotAuthorized>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4">
                    <a href="@AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.Logout">Cerrar Sesión</a>
                    <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStat { get; set; } = default!;

    [Inject]
    private IHttpContextAccessor _httpContextAccessor { get; set; } = default!;

    protected async override Task OnInitializedAsync()
    {
        var user = (await AuthStat)?.User;
        if (user is null || user.Identity is null || !user.Identity.IsAuthenticated)
        {
            var currentPath = _navigation.ToBaseRelativePath(_navigation.Uri);
            var loggedOutPath = AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.LoggedOut.TrimStart('/');

            if (!string.Equals(currentPath, loggedOutPath, StringComparison.OrdinalIgnoreCase) &&
                !currentPath.StartsWith(AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.Login.TrimStart('/'), StringComparison.OrdinalIgnoreCase))
            {
                _navigation.NavigateTo(AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.LoggedOut, false, true);
            }
        }
    }
}
