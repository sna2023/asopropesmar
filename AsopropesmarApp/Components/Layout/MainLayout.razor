@inherits LayoutComponentBase
@inject NavigationManager _navigation

<AuthorizeView>
    <NotAuthorized>
        @Body
    </NotAuthorized>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4">
                    <a href="@Helpers.Route.Cuenta.Autenticacion.Logout" data-enhance-nav="false">Cerrar Sesión</a>
                    <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>

        <div id="blazor-error-ui" data-nosnippet>
            An unhandled error has occurred.
            <a href="." class="reload">Reload</a>
            <span class="dismiss">🗙</span>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStat != null)
        {
            var user = (await AuthStat).User;
            if (user.Identity is null || !user.Identity.IsAuthenticated)
            {
                var relativePath = _navigation.ToBaseRelativePath(_navigation.Uri);
                var currentPath = "/" + relativePath;
                if (!currentPath.Equals(Helpers.Route.Cuenta.Autenticacion.LoggedOut, StringComparison.OrdinalIgnoreCase))
                {
                    _navigation.NavigateTo(Helpers.Route.Cuenta.Autenticacion.LoggedOut, false, true);
                }
            }
        }
    }
}
