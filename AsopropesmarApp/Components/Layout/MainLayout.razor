@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager _navigation

<AuthorizeView>
    <NotAuthorized>
        @Body
    </NotAuthorized>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4">
                    <a href="/Cuenta/Autenticacion/Logout">Cerrar Sesión</a>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    protected async override Task OnInitializedAsync()
    {
        if (AuthStat != null)
        {
            var user = (await AuthStat).User;
            if (user is null || user.Identity is null || !user.Identity.IsAuthenticated)
            {
                var relativePath = "/" + _navigation.ToBaseRelativePath(_navigation.Uri);
                if (relativePath != AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.LoggedOut && relativePath != AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.Login)
                {
                    _navigation.NavigateTo(AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.LoggedOut, false, true);
                }
            }
        }
    }
}
