@inherits LayoutComponentBase
@inject NavigationManager _navigation
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor _contextAccessor

<AuthorizeView>
    <NotAuthorized>
        @Body
    </NotAuthorized>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4">
                    <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
                    <a href="/Cuenta/Autenticacion/Logout" class="ms-3">Cerrar Sesión</a>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>

        <div id="blazor-error-ui">
            An unhandled error has occurred.
            <a href="" class="reload">Reload</a>
            <a class="dismiss">🗙</a>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    protected async override Task OnInitializedAsync()
    {
        if (AuthStat != null)
        {
            var authState = await AuthStat;
            var user = authState.User;
            if (user?.Identity == null || !user.Identity.IsAuthenticated)
            {
                var uri = new Uri(_navigation.Uri);
                var path = uri.AbsolutePath;
                if (path != "/Cuenta/Autenticacion/LoggedOut" && path != "/Cuenta/Autenticacion/Login")
                {
                    _navigation.NavigateTo("/Cuenta/Autenticacion/LoggedOut", false, true);
                }
            }
        }
    }
}
