@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Authorization
@using AsopropesmarApp.Helpers

<AuthorizeView>
    <NotAuthorized>
        @if (NavigationManager.ToBaseRelativePath(NavigationManager.Uri) == "Cuenta/Autenticacion/LoggedOut")
        {
            @Body
        }
    </NotAuthorized>
    <Authorized>
        <nav class="navbar navbar-expand-lg sticky-top" id="navbar">
            <div class="container">
                <a class="navbar-brand" href="#">
                    <img src="asopro.jpeg" alt="ASOPROPESMAR" height="50" class="me-2">
                </a>
                <button class="navbar-toggler bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" href="#inicio">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" href="#nosotros">Nosotros</a></li>
                        <li class="nav-item"><a class="nav-link" href="#servicios">Servicios</a></li>
                        <li class="nav-item"><a class="nav-link" href="#galeria">Galería</a></li>
                        <li class="nav-item"><a class="nav-link" href="#asociados">Asociados</a></li>
                        <li class="nav-item"><a class="nav-link" href="#contacto">Contacto</a></li>
                        <li class="nav-item ms-3">
                            <a href="@Route.Cuenta.Autenticacion.Logout" data-enhance-nav="false" class="btn btn-outline-danger">
                                <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        @Body
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    protected async override Task OnInitializedAsync()
    {
        var authState = AuthStat is not null ? await AuthStat : null;
        var user = authState?.User;

        if (user is null || user.Identity is null || !user.Identity.IsAuthenticated)
        {
            var relativePath = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            if (relativePath != Route.Cuenta.Autenticacion.LoggedOut && relativePath != Route.Cuenta.Autenticacion.Login)
            {
                NavigationManager.NavigateTo(Route.Cuenta.Autenticacion.LoggedOut, forceLoad: true);
            }
        }
    }
}
