@inherits LayoutComponentBase
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4">
                    <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
                    <a href="/Cuenta/Autenticacion/Logout">Cerrar Sesión</a>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>

        <div id="blazor-error-ui" data-nosnippet>
            An unhandled error has occurred.
            <a href="." class="reload">Reload</a>
            <span class="dismiss">🗙</span>
        </div>
    </Authorized>
    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    protected async override Task OnInitializedAsync()
    {
        if (AuthStat != null)
        {
            var user = (await AuthStat).User;
            if (user?.Identity == null || !user.Identity.IsAuthenticated)
            {
                var uri = new Uri(Navigation.Uri);
                if (!uri.AbsolutePath.Equals("/Cuenta/Autenticacion/LoggedOut", StringComparison.OrdinalIgnoreCase) &&
                    !uri.AbsolutePath.Equals("/Cuenta/Autenticacion/Login", StringComparison.OrdinalIgnoreCase))
                {
                    Navigation.NavigateTo("/Cuenta/Autenticacion/LoggedOut", forceLoad: true);
                }
            }
        }
    }
}
