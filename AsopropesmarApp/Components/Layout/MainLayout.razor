@inherits LayoutComponentBase
@using AsopropesmarApp.Helpers
@inject NavigationManager _navigation

<AuthorizeView>
    <NotAuthorized>
        @Body
    </NotAuthorized>
    <Authorized>
        <!-- Navbar -->
        <nav class="navbar navbar-expand-lg sticky-top">
            <div class="container">
                <a class="navbar-brand" href="#">
                    <i class="bi bi-water me-2"></i>ASOPROPESMAR
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link active" href="#inicio">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#nosotros">Nosotros</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#servicios">Servicios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#directiva">Directiva</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#intranet">Intranet</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#contacto">Contacto</a>
                        </li>
                    </ul>
                    <div class="d-flex ms-lg-3 mt-3 mt-lg-0">
                        <a href="@Route.Cuenta.Autenticacion.Logout" data-enhance-nav="false" class="btn btn-outline-light w-100 w-lg-auto">
                            <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión
                        </a>
                    </div>
                </div>
            </div>
        </nav>

        @Body

        <!-- Footer -->
        <footer class="footer text-center">
            <div class="container">
                <div class="row">
                    <div class="col-md-4 mb-4">
                        <h5>ASOPROPESMAR</h5>
                        <p class="small">Asociación de Producción Pesquera Manabí Artesanal</p>
                    </div>
                    <div class="col-md-4 mb-4">
                        <h5>Enlaces</h5>
                        <ul class="list-unstyled">
                            <li><a href="#inicio" class="text-white-50 text-decoration-none">Inicio</a></li>
                            <li><a href="#nosotros" class="text-white-50 text-decoration-none">Nosotros</a></li>
                            <li><a href="#servicios" class="text-white-50 text-decoration-none">Servicios</a></li>
                        </ul>
                    </div>
                    <div class="col-md-4 mb-4">
                        <h5>Datos 2026</h5>
                        <p class="small">Más de 200 pescadores asociados</p>
                        <p class="small">15+ años de experiencia</p>
                    </div>
                </div>
                <hr style="border-color: rgba(255,255,255,0.2);">
                <p>&copy; 2026 ASOPROPESMAR. Todos los derechos reservados.</p>
            </div>
        </footer>
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    protected async override Task OnInitializedAsync()
    {
        var user = (await AuthStat!).User;
        if (user is null || user.Identity is null || !user.Identity.IsAuthenticated)
        {
            var relativePath = "/" + _navigation.ToBaseRelativePath(_navigation.Uri);
            if (relativePath != Route.Cuenta.Autenticacion.LoggedOut && relativePath != Route.Cuenta.Autenticacion.Login)
            {
                _navigation.NavigateTo(Route.Cuenta.Autenticacion.LoggedOut, forceLoad: true);
            }
        }
    }
}