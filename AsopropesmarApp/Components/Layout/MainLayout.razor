@inherits LayoutComponentBase
@inject NavigationManager _navigation
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor _context

<AuthorizeView>
    <NotAuthorized>
        @Body
    </NotAuthorized>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4">
                    <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
                    <a href="/Cuenta/Autenticacion/Logout" class="ms-3">Cerrar Sesión</a>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    protected async override Task OnInitializedAsync()
    {
        if (AuthStat is not null)
        {
            var user = (await AuthStat).User;
            if (user is null || user.Identity is null || !user.Identity.IsAuthenticated)
            {
                var loggedOutPath = AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.LoggedOut;

                // Note: GetPathAndQuery might return path with starting slash.
                // Request.Path does have starting slash.
                if (_context?.HttpContext?.Request.Path.Value?.Equals(loggedOutPath, StringComparison.OrdinalIgnoreCase) != true &&
                    !_navigation.ToBaseRelativePath(_navigation.Uri).Equals(loggedOutPath.TrimStart('/'), StringComparison.OrdinalIgnoreCase))
                {
                    _navigation.NavigateTo(loggedOutPath, false, true);
                }
            }
        }
    }
}
