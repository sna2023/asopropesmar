@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager _navigation

<div class="page">
    <AuthorizeView>
        <Authorized>
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4">
                    <a href="/Cuenta/Autenticacion/Logout">Cerrar Sesión</a>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </Authorized>
        <NotAuthorized>
            <main>
                <article class="content px-4">
                    @Body
                </article>
            </main>
        </NotAuthorized>
    </AuthorizeView>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    protected async override Task OnInitializedAsync()
    {
        var authState = AuthStat is not null ? await AuthStat : null;
        var user = authState?.User;
        if (user is null || user.Identity is null || !user.Identity.IsAuthenticated)
        {
            var loggedOutPath = Helpers.Route.Cuenta.Autenticacion.LoggedOut;
            if (_navigation.ToBaseRelativePath(_navigation.Uri) != loggedOutPath.TrimStart('/'))
            {
                _navigation.NavigateTo(loggedOutPath, false, true);
            }
        }
    }
}
