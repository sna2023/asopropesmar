@inherits LayoutComponentBase
@inject NavigationManager _navigation
@inject IHttpContextAccessor _context

<AuthorizeView>
    <NotAuthorized>
        @Body
    </NotAuthorized>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4">
                    <span>Bienvenido, @context.User.Identity?.Name</span>
                    <a href="@Helpers.Route.Cuenta.Autenticacion.Logout" class="ms-3" data-enhance-nav="false">Cerrar Sesión</a>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    protected async override Task OnInitializedAsync()
    {
        if (AuthStat is not null)
        {
            var authState = await AuthStat;
            var user = authState.User;
            if (user.Identity is null || !user.Identity.IsAuthenticated)
            {
                if (_context?.HttpContext?.Request.Path != Helpers.Route.Cuenta.Autenticacion.LoggedOut)
                {
                    _navigation.NavigateTo(Helpers.Route.Cuenta.Autenticacion.LoggedOut, forceLoad: true);
                }
            }
        }
    }
}