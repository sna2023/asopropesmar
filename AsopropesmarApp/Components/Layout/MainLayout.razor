@inherits LayoutComponentBase
@inject NavigationManager _navigation
@inject IHttpContextAccessor _context

<AuthorizeView>
    <NotAuthorized>
        @Body
    </NotAuthorized>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4">
                    <a href="@AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.Logout" data-enhance-nav="false">Cerrar Sesión</a>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>

        <div id="blazor-error-ui" data-nosnippet>
            An unhandled error has occurred.
            <a href="." class="reload">Reload</a>
            <span class="dismiss">🗙</span>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    protected async override Task OnInitializedAsync()
    {
        var user = AuthStat is not null ? (await AuthStat).User : null;
        if (user is null || user.Identity is null || !user.Identity.IsAuthenticated)
        {
            var loggedOutPath = AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.LoggedOut;
            var path = _context.HttpContext?.Request.Path.Value ?? "";

            // ToBaseRelativePath returns string without a leading slash
            var relativePath = "/" + _navigation.ToBaseRelativePath(_navigation.Uri);

            if (!string.Equals(path, loggedOutPath, StringComparison.OrdinalIgnoreCase) &&
                !string.Equals(relativePath, loggedOutPath, StringComparison.OrdinalIgnoreCase))
            {
                _navigation.NavigateTo(loggedOutPath, forceLoad: false, replace: true);
            }
        }
    }
}
