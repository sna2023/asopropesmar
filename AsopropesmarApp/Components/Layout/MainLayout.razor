@inherits LayoutComponentBase
@inject NavigationManager _navigation
@using Microsoft.AspNetCore.Components.Authorization
@using AsopropesmarApp.Helpers

<AuthorizeView>
    <NotAuthorized>
        @Body
    </NotAuthorized>
    <Authorized>
        <!-- Navbar Header (Migrated from index.html) -->
        <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" href="@Route.Inicio.Bienvenida">
                    <img src="asopro.jpeg" alt="Logo" class="logo-img me-2">
                    <span class="brand-text">ASOPROPESMAR</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item">
                            <a class="nav-link active" href="#inicio">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#nosotros">Nosotros</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#servicios">Servicios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#contacto">Contacto</a>
                        </li>
                        <li class="nav-item ms-lg-3 mt-3 mt-lg-0">
                            <a href="@Route.Cuenta.Autenticacion.Logout" data-enhance-nav="false" class="btn btn-outline-light rounded-pill px-4">
                                <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <main>
            @Body
        </main>

        <!-- Footer (Migrated from index.html) -->
        <footer class="footer text-center mt-5" style="background: var(--primary-color); color: white; padding: 2rem 0;">
            <div class="container">
                <div class="row">
                    <div class="col-md-4 mb-4">
                        <h5>ASOPROPESMAR</h5>
                        <p class="small">Asociación de Producción Pesquera Manabí Artesanal</p>
                    </div>
                    <div class="col-md-4 mb-4">
                        <h5>Enlaces</h5>
                        <ul class="list-unstyled">
                            <li><a href="#inicio" class="text-white-50 text-decoration-none">Inicio</a></li>
                            <li><a href="#nosotros" class="text-white-50 text-decoration-none">Nosotros</a></li>
                            <li><a href="#servicios" class="text-white-50 text-decoration-none">Servicios</a></li>
                        </ul>
                    </div>
                    <div class="col-md-4 mb-4">
                        <h5>Datos 2026</h5>
                        <p class="small">Más de 200 pescadores asociados</p>
                        <p class="small">15+ años de experiencia</p>
                    </div>
                </div>
                <hr style="border-color: rgba(255,255,255,0.2);">
                <p>&copy; 2026 ASOPROPESMAR. Todos los derechos reservados.</p>
            </div>
        </footer>
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    protected async override Task OnInitializedAsync()
    {
        var authState = await (AuthStat ?? Task.FromResult<AuthenticationState>(null!));
        var user = authState?.User;

        if (user is null || user.Identity is null || !user.Identity.IsAuthenticated)
        {
            var relativePath = _navigation.ToBaseRelativePath(_navigation.Uri);
            var targetPath = Route.Cuenta.Autenticacion.LoggedOut.TrimStart('/');
            if (relativePath != targetPath)
            {
                _navigation.NavigateTo(Route.Cuenta.Autenticacion.LoggedOut, false, true);
            }
        }
    }
}