@inherits LayoutComponentBase
@inject NavigationManager _navigation

<AuthorizeView>
    <NotAuthorized>
        @Body
    </NotAuthorized>
    <Authorized>
        <!-- Navegación -->
        <nav class="navbar navbar-expand-lg sticky-top" id="navbar">
            <div class="container">
                <a class="navbar-brand" href="#">
                    <img src="asopro.jpeg" alt="ASOPROPESMAR" height="50" class="me-2">
                </a>
                <button class="navbar-toggler bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" href="#inicio">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" href="#nosotros">Nosotros</a></li>
                        <li class="nav-item"><a class="nav-link" href="#servicios">Servicios</a></li>
                        <li class="nav-item"><a class="nav-link" href="#galeria">Galería</a></li>
                        <li class="nav-item"><a class="nav-link" href="#asociados">Asociados</a></li>
                        <li class="nav-item"><a class="nav-link" href="#contacto">Contacto</a></li>
                        <li class="nav-item"><a class="nav-link text-danger" href="/Cuenta/Autenticacion/Logout" data-enhance-nav="false">Cerrar Sesión</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        @Body

        <!-- Footer -->
        <footer class="footer py-4 text-center">
            <div class="container">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <h5>ASOPROPESMAR</h5>
                        <p>Trabajando por el desarrollo pesquero de Manabí.</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <h5>Enlaces Rápidos</h5>
                        <ul class="list-unstyled">
                            <li><a href="#inicio" class="text-white">Inicio</a></li>
                            <li><a href="#servicios" class="text-white">Servicios</a></li>
                            <li><a href="#contacto" class="text-white">Contacto</a></li>
                        </ul>
                    </div>
                    <div class="col-md-4 mb-3">
                        <h5>Síguenos</h5>
                        <a href="#" class="text-white me-2 fs-4"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-white me-2 fs-4"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-white fs-4"><i class="bi bi-twitter-x"></i></a>
                    </div>
                </div>
                <hr>
                <p class="mb-0">&copy; 2024 ASOPROPESMAR. Todos los derechos reservados.</p>
            </div>
        </footer>

        <!-- Botón flotante WhatsApp -->
        <a href="https://wa.me/593979870502" class="whatsapp-btn" target="_blank" aria-label="Chat por WhatsApp">
            <span class="iconify" data-icon="logos:whatsapp-icon"></span>
        </a>
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStat != null)
        {
            var user = (await AuthStat).User;
            if (user is null || user.Identity is null || !user.Identity.IsAuthenticated)
            {
                var relativePath = _navigation.ToBaseRelativePath(_navigation.Uri);
                if (relativePath != AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.LoggedOut.TrimStart('/'))
                {
                    _navigation.NavigateTo(AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.LoggedOut, false, true);
                }
            }
        }
    }
}
