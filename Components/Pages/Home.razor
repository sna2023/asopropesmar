@page "/"
@attribute [Authorize]

<PageTitle>Inicio - AsopropesmarApp</PageTitle>

<h1>Bienvenido a AsopropesmarApp</h1>

<p>Has iniciado sesión correctamente.</p>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card text-white bg-primary mb-3">
            <div class="card-header">Total Asociados</div>
            <div class="card-body">
                <h5 class="card-title">0</h5>
                <p class="card-text">Total de miembros registrados en la asociación.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-success mb-3">
            <div class="card-header">Activos</div>
            <div class="card-body">
                <h5 class="card-title">0</h5>
                <p class="card-text">Miembros actualmente activos.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-danger mb-3">
            <div class="card-header">Inactivos</div>
            <div class="card-body">
                <h5 class="card-title">0</h5>
                <p class="card-text">Miembros inactivos.</p>
            </div>
        </div>
    </div>
</div>
