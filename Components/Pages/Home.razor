@page "/"
@page "/inicio"

<PageTitle>Inicio - AsopropesmarApp</PageTitle>

<!-- Hero Section -->
<section id="inicio" class="hero-section">
    <div class="hero-content">
        <h1 class="display-3 fw-bold mb-4 animate-up">ASOPROPESMAR</h1>
        <p class="lead mb-4 animate-up" style="animation-delay: 0.2s;">
            Asociación de Producción Pesquera Manabí Artesanal
        </p>
        <div class="animate-up" style="animation-delay: 0.4s;">
            <a href="#nosotros" class="btn btn-primary btn-lg me-3">Conócenos</a>
            <a href="#servicios" class="btn btn-outline-light btn-lg">Nuestros Servicios</a>
        </div>
    </div>
</section>

<!-- Nosotros -->
<section id="nosotros" class="section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <img src="asopro.jpeg" alt="Pescadores artesanales" class="img-fluid rounded-4 shadow-lg feature-img">
            </div>
            <div class="col-lg-6">
                <h2 class="section-title">Nuestra Historia</h2>
                <p class="lead text-muted">Impulsando el desarrollo sostenible de la pesca artesanal en Manabí.</p>
                <p>Somos una asociación comprometida con el bienestar de nuestros pescadores y la preservación de los recursos marinos. Trabajamos día a día para mejorar las condiciones de trabajo y garantizar productos de la más alta calidad.</p>

                <div class="row mt-4">
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-check-circle-fill text-primary fs-4 me-3"></i>
                            <h5 class="mb-0">Pesca Sostenible</h5>
                        </div>
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-check-circle-fill text-primary fs-4 me-3"></i>
                            <h5 class="mb-0">Comercio Justo</h5>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-check-circle-fill text-primary fs-4 me-3"></i>
                            <h5 class="mb-0">Calidad Garantizada</h5>
                        </div>
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-check-circle-fill text-primary fs-4 me-3"></i>
                            <h5 class="mb-0">Apoyo Comunitario</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Servicios -->
<section id="servicios" class="section bg-light">
    <div class="container">
        <h2 class="section-title text-center">Nuestros Servicios</h2>
        <div class="row g-4 mt-3">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm service-card">
                    <div class="card-body text-center p-4">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-inline-block p-3 mb-4">
                            <i class="bi bi-water fs-1 text-primary"></i>
                        </div>
                        <h4>Acopio y Distribución</h4>
                        <p class="text-muted">Centro de acopio equipado con tecnología moderna para mantener la cadena de frío.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm service-card">
                    <div class="card-body text-center p-4">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-inline-block p-3 mb-4">
                            <i class="bi bi-shield-check fs-1 text-primary"></i>
                        </div>
                        <h4>Asesoría Legal</h4>
                        <p class="text-muted">Apoyo en trámites de permisos de pesca y regularización de embarcaciones.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm service-card">
                    <div class="card-body text-center p-4">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-inline-block p-3 mb-4">
                            <i class="bi bi-tools fs-1 text-primary"></i>
                        </div>
                        <h4>Mantenimiento</h4>
                        <p class="text-muted">Taller de reparaciones de motores fuera de borda y mantenimiento preventivo.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
