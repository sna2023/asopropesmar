@page "/"

<PageTitle>ASOPROPESMAR - Asociación de Producción Pesquera Manabí Artesanal</PageTitle>

<!-- Navegación -->
<nav class="navbar navbar-expand-lg sticky-top" id="navbar">
    <div class="container">
        <a class="navbar-brand" href="#">
            <img src="asopro.jpeg" alt="ASOPROPESMAR" height="50" class="me-2">
        </a>
        <button class="navbar-toggler bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="#inicio">Inicio</a></li>
                <li class="nav-item"><a class="nav-link" href="#nosotros">Nosotros</a></li>
                <li class="nav-item"><a class="nav-link" href="#servicios">Servicios</a></li>
                <li class="nav-item"><a class="nav-link" href="#galeria">Galería</a></li>
                <li class="nav-item"><a class="nav-link" href="#asociados">Asociados</a></li>
                <li class="nav-item"><a class="nav-link" href="#contacto">Contacto</a></li>
            </ul>
        </div>
    </div>
</nav>

<!-- Hero Section con peces -->
<section id="inicio" class="hero-section">
    <!-- Peces nadando -->
    <div class="fish" style="top: 15%; animation-duration: 12s; animation-delay: 0s;">
        <span class="iconify" data-icon="noto:fish" style="font-size: 40px; color: #4bcffa;"></span>
    </div>
    <div class="fish" style="top: 35%; animation-duration: 18s; animation-delay: -5s;">
        <span class="iconify" data-icon="noto:fish" style="font-size: 32px; color: #f4d03f;"></span>
    </div>
    <div class="container">
        <h1>Pescadores Artesanales de Manabí</h1>
        <p class="lead">Tradición, calidad y sustentabilidad en cada captura</p>
    </div>
</section>

<!-- Nosotros -->
<section id="nosotros" class="py-5">
    <div class="container text-center">
        <h2>Quiénes Somos</h2>
        <p class="mt-4">Somos una asociación dedicada a la pesca artesanal en la provincia de Manabí, comprometidos con la conservación marina y el desarrollo de nuestras comunidades costeras. Trabajamos para ofrecer productos frescos del mar a su mesa, apoyando a las familias pescadoras locales.</p>
    </div>
</section>

<!-- Footer -->
<footer class="bg-dark text-white py-4">
    <div class="container text-center">
        <p>&copy; 2023 ASOPROPESMAR. Todos los derechos reservados.</p>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
