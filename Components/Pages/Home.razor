@page "/"

<PageTitle>Inicio</PageTitle>

<!-- Inicio -->
<section id="inicio" class="hero-section text-center text-white d-flex align-items-center">
    <div class="container hero-content">
        <h1 class="display-3 fw-bold mb-4">ASOPROPESMAR</h1>
        <p class="lead mb-5 fs-4">Asociación de Producción Pesquera Manabí Artesanal</p>
        <div class="d-flex justify-content-center gap-3">
            <a href="#nosotros" class="btn btn-primary btn-lg rounded-pill px-4 py-2 text-white border-0 shadow" style="background-color: #004d40;">Conócenos</a>
            <a href="#servicios" class="btn btn-outline-light btn-lg rounded-pill px-4 py-2">Servicios</a>
        </div>
    </div>
</section>

<!-- Nosotros -->
<section id="nosotros" class="section bg-light">
    <div class="container">
        <h2 class="section-title">Sobre Nosotros</h2>
        <div class="row align-items-center g-5">
            <div class="col-md-6">
                <img src="asopro.jpeg" alt="Pescadores Artesanales" class="img-fluid rounded-4 shadow-lg w-100">
            </div>
            <div class="col-md-6">
                <h3 class="mb-4 text-primary"><i class="bi bi-water me-2"></i>Nuestra Historia</h3>
                <p class="lead text-muted">Somos una organización dedicada al desarrollo y fortalecimiento del sector pesquero artesanal en Manabí.</p>
                <div class="row mt-4">
                    <div class="col-sm-6 mb-4">
                        <div class="p-3 bg-white rounded-3 shadow-sm h-100 border-start border-primary border-4">
                            <h5 class="text-primary"><i class="bi bi-eye me-2"></i>Misión</h5>
                            <p class="mb-0 text-muted small">Promover la pesca sostenible y mejorar la calidad de vida de nuestros asociados mediante prácticas responsables y comercio justo.</p>
                        </div>
                    </div>
                    <div class="col-sm-6 mb-4">
                        <div class="p-3 bg-white rounded-3 shadow-sm h-100 border-start border-success border-4">
                            <h5 class="text-success"><i class="bi bi-bullseye me-2"></i>Visión</h5>
                            <p class="mb-0 text-muted small">Ser líderes en la pesca artesanal sostenible en Ecuador, reconocidos por nuestra calidad y compromiso ambiental.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Servicios -->
<section id="servicios" class="section">
    <div class="container">
        <h2 class="section-title">Nuestros Servicios</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 service-card">
                    <div class="card-body text-center p-4">
                        <div class="icon-wrapper bg-primary text-white rounded-circle mb-3 mx-auto">
                            <i class="bi bi-droplet-fill fs-3"></i>
                        </div>
                        <h5 class="card-title fw-bold">Pesca Sostenible</h5>
                        <p class="card-text text-muted">Prácticas de pesca que respetan el ecosistema marino y aseguran el recurso para futuras generaciones.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 service-card">
                    <div class="card-body text-center p-4">
                        <div class="icon-wrapper bg-success text-white rounded-circle mb-3 mx-auto">
                            <i class="bi bi-shop fs-3"></i>
                        </div>
                        <h5 class="card-title fw-bold">Comercialización</h5>
                        <p class="card-text text-muted">Venta directa de productos del mar frescos y de calidad, garantizando precios justos.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 service-card">
                    <div class="card-body text-center p-4">
                        <div class="icon-wrapper bg-info text-white rounded-circle mb-3 mx-auto">
                            <i class="bi bi-people-fill fs-3"></i>
                        </div>
                        <h5 class="card-title fw-bold">Capacitación</h5>
                        <p class="card-text text-muted">Programas de formación continua para nuestros asociados en técnicas y seguridad marítima.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Base de Datos (Sistema de Asociados) -->
<section id="asociados" class="section bg-light">
    <div class="container">
        <h2 class="section-title">Sistema de Gestión de Asociados</h2>

        <!-- Dashboard Stats -->
        <div class="row g-4 mb-5 text-center">
            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-people-fill fs-1 mb-3"></i>
                    <div class="stat-number" id="totalMembers">0</div>
                    <p>Total Asociados</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-person-check-fill fs-1 mb-3"></i>
                    <div class="stat-number" id="activeMembers">0</div>
                    <p>Activos</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-person-dash-fill fs-1 mb-3"></i>
                    <div class="stat-number" id="inactiveMembers">0</div>
                    <p>Inactivos</p>
                </div>
            </div>
        </div>

        <div class="db-section">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="mb-0"><i class="bi bi-database me-2"></i>Base de Datos de Asociados</h4>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#memberModal">
                    <i class="bi bi-plus-circle me-1"></i> Nuevo Asociado
                </button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover" id="membersTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th>Tipo</th>
                            <th>Estado</th>
                            <th>Fecha</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="membersTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!-- Contacto -->
<section id="contacto" class="section contact-section">
    <div class="container">
        <h2 class="section-title" style="color: white;">Contacto</h2>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="contact-card">
                    <h4 class="mb-4"><i class="bi bi-geo-alt me-2"></i>Información de Contacto</h4>
                    <div class="mb-3">
                        <p><i class="bi bi-person-badge me-2"></i><strong>Representante:</strong> Walter González Klegan</p>
                        <p><i class="bi bi-telephone me-2"></i><strong>Teléfono:</strong> +593 981452439</p>
                        <p><i class="bi bi-envelope me-2"></i><strong>Email:</strong> info@asopropesmar.org.ec</p>
                        <p><i class="bi bi-geo-alt me-2"></i><strong>Ubicación:</strong> Manta, Manabí, Ecuador</p>
                        <p><i class="bi bi-clock me-2"></i><strong>Horario:</strong> Lunes a Viernes 8:00 - 17:00</p>
                    </div>
                    <div class="mt-4">
                        <a href="#" class="btn btn-outline-light me-2"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="btn btn-outline-light me-2"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="btn btn-outline-light"><i class="bi bi-whatsapp"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="contact-card">
                    <h4 class="mb-4"><i class="bi bi-map me-2"></i>Nuestra Ubicación</h4>
                    <div class="map-container">
                        <iframe src="https://www.openstreetmap.org/export/embed.html?bbox=-80.72%2C-0.96%2C-80.68%2C-0.92&amp;layer=mapnik&amp;marker=-0.95%2C-80.70"
                                width="100%" height="300" style="border:0; border-radius: 15px;" allowfullscreen loading="lazy"></iframe>
                    </div>
                    <p class="mt-3 text-center"><small> Puerto de Manta, Manabí - Ecuador</small></p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modal Nuevo Asociado -->
<div class="modal fade" id="memberModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>Nuevo Asociado</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="memberForm">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Nombres *</label>
                            <input type="text" class="form-control" id="memberFirstName" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Apellidos *</label>
                            <input type="text" class="form-control" id="memberLastName" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email *</label>
                        <input type="email" class="form-control" id="memberEmail" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Teléfono *</label>
                        <input type="tel" class="form-control" id="memberPhone" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tipo</label>
                        <select class="form-select" id="memberType">
                            <option value="pescador">Pescador</option>
                            <option value="acuicultor">Acuicultor</option>
                            <option value="procesador">Procesador</option>
                            <option value="comerciante">Comerciante</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Estado</label>
                        <select class="form-select" id="memberStatus">
                            <option value="activo">Activo</option>
                            <option value="inactivo">Inactivo</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Guardar</button>
                </form>
            </div>
        </div>
    </div>
</div>
