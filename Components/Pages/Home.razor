<!-- Hero Section -->
<section id="inicio" class="hero-section">
    <div class="container">
        <div class="hero-content">
            <h1 class="display-4 fw-bold mb-4">Uniendo fuerzas por el mar y nuestra gente</h1>
            <p class="lead mb-4">Trabajando juntos por un desarrollo pesquero sostenible en Manabí.</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="#nosotros" class="btn btn-primary btn-lg px-4">Conócenos</a>
                <a href="#contacto" class="btn btn-outline-light btn-lg px-4">Contáctanos</a>
            </div>
        </div>
    </div>
</section>

<!-- Nosotros -->
<section id="nosotros" class="section bg-light text-dark">
    <div class="container">
        <h2 class="section-title">Sobre Nosotros</h2>
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <img src="asopro.jpeg" alt="Asociación" class="img-fluid rounded shadow">
            </div>
            <div class="col-lg-6">
                <h3 class="mb-4">Nuestra Historia</h3>
                <p>ASOPROPESMAR es la Asociación de Producción Pesquera Manabí Artesanal, fundada con el propósito de mejorar la calidad de vida de nuestros pescadores artesanales y sus familias, promoviendo prácticas de pesca responsables y sostenibles en las costas ecuatorianas.</p>
                <div class="row mt-4">
                    <div class="col-sm-6 mb-3">
                        <h5><i class="bi bi-bullseye text-primary me-2"></i>Misión</h5>
                        <p class="small">Promover el desarrollo sostenible del sector pesquero artesanal de Manabí a través de la organización y capacitación de sus miembros.</p>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <h5><i class="bi bi-eye text-primary me-2"></i>Visión</h5>
                        <p class="small">Ser la organización líder en producción pesquera artesanal, reconocida por sus prácticas sostenibles y el bienestar de sus asociados.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Servicios -->
<section id="servicios" class="section text-white">
    <div class="container">
        <h2 class="section-title text-white">Nuestros Servicios</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card bg-dark text-white h-100 border-secondary">
                    <div class="card-body text-center p-4">
                        <i class="bi bi-diagram-3 display-4 text-primary mb-3 d-block"></i>
                        <h4>Organización Gremial</h4>
                        <p class="small mb-0">Representación legal y defensa de los derechos de nuestros asociados ante las autoridades competentes.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-dark text-white h-100 border-secondary">
                    <div class="card-body text-center p-4">
                        <i class="bi bi-book display-4 text-primary mb-3 d-block"></i>
                        <h4>Capacitación</h4>
                        <p class="small mb-0">Programas de formación en técnicas de pesca sostenible, seguridad marítima y administración.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-dark text-white h-100 border-secondary">
                    <div class="card-body text-center p-4">
                        <i class="bi bi-shop display-4 text-primary mb-3 d-block"></i>
                        <h4>Comercialización</h4>
                        <p class="small mb-0">Apoyo en la comercialización directa de productos del mar para mejorar los ingresos familiares.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Miembros de la Directiva -->
<section id="miembros" class="section bg-light text-dark">
    <div class="container">
        <h2 class="section-title">Nuestra Directiva</h2>
        <div class="row g-4 justify-content-center">
            <div class="col-md-4">
                <div class="member-card text-center">
                    <img src="https://via.placeholder.com/150" alt="Presidente" class="member-img">
                    <h4 class="mb-1">Walter González</h4>
                    <p class="text-primary mb-3">Presidente</p>
                    <p class="small">Líder comprometido con el desarrollo de la pesca artesanal en Manabí.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="member-card text-center">
                    <img src="https://via.placeholder.com/150" alt="Vicepresidente" class="member-img">
                    <h4 class="mb-1">María Delgado</h4>
                    <p class="text-primary mb-3">Vicepresidenta</p>
                    <p class="small">Especialista en desarrollo comunitario y gestión de proyectos pesqueros.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="member-card text-center">
                    <img src="https://via.placeholder.com/150" alt="Secretario" class="member-img">
                    <h4 class="mb-1">Carlos Mendoza</h4>
                    <p class="text-primary mb-3">Secretario General</p>
                    <p class="small">Encargado de la coordinación administrativa y registro de asociados.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Panel de Administración -->
<section id="admin" class="section bg-dark">
    <div class="container">
        <h2 class="section-title text-white">Panel de Administración</h2>

        <!-- Estadísticas -->
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-people-fill fs-1 mb-3"></i>
                    <div class="stat-number" id="totalMembers">0</div>
                    <p>Total Asociados</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-person-check-fill fs-1 mb-3"></i>
                    <div class="stat-number" id="activeMembers">0</div>
                    <p>Activos</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-person-dash-fill fs-1 mb-3"></i>
                    <div class="stat-number" id="inactiveMembers">0</div>
                    <p>Inactivos</p>
                </div>
            </div>
        </div>

        <div class="db-section">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="mb-0 text-white"><i class="bi bi-database me-2"></i>Base de Datos de Asociados</h4>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#memberModal">
                    <i class="bi bi-plus-circle me-1"></i> Nuevo Asociado
                </button>
            </div>
            <div class="table-responsive bg-white rounded p-3">
                <table class="table table-hover" id="membersTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th>Tipo</th>
                            <th>Estado</th>
                            <th>Fecha</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="membersTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</section>

