@page "/"

<PageTitle>ASOPROPESMAR - Asociación de Producción Pesquera Manabí Artesanal</PageTitle>

<!-- Sección Inicio -->
<section id="inicio" class="hero-section d-flex align-items-center">
    <div class="container text-center text-white">
        <h1 class="display-3 fw-bold mb-4 text-shadow slide-up">Pesca Artesanal Sostenible</h1>
        <p class="lead mb-5 text-shadow fade-in">Desde el mar de Manabí hasta su mesa, con calidad y tradición</p>
        <a href="#productos" class="btn btn-primary btn-lg px-5 py-3 rounded-pill hover-scale">Descubre Nuestros Productos</a>
    </div>
</section>

<!-- Sección Nosotros -->
<section id="nosotros" class="py-5 bg-light">
    <div class="container py-5">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0 pe-lg-5">
                <div class="about-image-wrapper">
                    <img src="Descarga del Día.jpg" alt="Pescadores de ASOPROPESMAR" class="img-fluid rounded-4 shadow-lg w-100 object-fit-cover" style="height: 500px;">
                    <div class="experience-badge">
                        <span class="fs-2 fw-bold text-white d-block">+10</span>
                        <span class="text-white-50">Años de Experiencia</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <span class="text-primary fw-bold text-uppercase tracking-wider">Sobre Nosotros</span>
                <h2 class="display-5 fw-bold mb-4 mt-2">ASOPROPESMAR</h2>
                <p class="lead text-muted mb-4">La Asociación de Producción Pesquera Manabí Artesanal, con sede en Manta, representa a las familias dedicadas a la pesca artesanal.</p>

                <div class="d-flex mb-4">
                    <div class="flex-shrink-0">
                        <i class="bi bi-water text-primary fs-2"></i>
                    </div>
                    <div class="ms-4">
                        <h5 class="fw-bold">Nuestra Misión</h5>
                        <p class="text-muted">Promover el desarrollo sostenible de la pesca artesanal en Manabí, garantizando el bienestar de nuestros asociados.</p>
                    </div>
                </div>

                <div class="d-flex">
                    <div class="flex-shrink-0">
                        <i class="bi bi-shield-check text-primary fs-2"></i>
                    </div>
                    <div class="ms-4">
                        <h5 class="fw-bold">Nuestra Visión</h5>
                        <p class="text-muted">Ser líderes en la comercialización de productos del mar de alta calidad, respetando el medio ambiente marino.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Sección Productos -->
<section id="productos" class="py-5">
    <div class="container py-5">
        <div class="text-center mb-5">
            <span class="text-primary fw-bold text-uppercase tracking-wider">Lo Mejor del Mar</span>
            <h2 class="display-5 fw-bold mt-2">Nuestros Productos</h2>
            <div class="divider mx-auto mt-3"></div>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card product-card h-100 border-0 shadow-sm">
                    <div class="card-img-wrapper">
                        <img src="producto.jpg" class="card-img-top" alt="Pescado Fresco">
                        <div class="overlay">
                            <a href="#" class="btn btn-light rounded-pill px-4">Ver Detalles</a>
                        </div>
                    </div>
                    <div class="card-body text-center p-4">
                        <h4 class="card-title fw-bold">Pescado Fresco</h4>
                        <p class="card-text text-muted">Dorado, Picudo, Wahoo y más especies capturadas en el día.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card product-card h-100 border-0 shadow-sm">
                    <div class="card-img-wrapper">
                        <img src="fondo.jpg" class="card-img-top" alt="Mariscos">
                        <div class="overlay">
                            <a href="#" class="btn btn-light rounded-pill px-4">Ver Detalles</a>
                        </div>
                    </div>
                    <div class="card-body text-center p-4">
                        <h4 class="card-title fw-bold">Mariscos Selectos</h4>
                        <p class="card-text text-muted">Camarón, calamar, pulpo y conchas de la más alta calidad.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card product-card h-100 border-0 shadow-sm bg-primary text-white text-center d-flex flex-column justify-content-center p-5">
                    <i class="bi bi-box-seam display-1 mb-3"></i>
                    <h4 class="fw-bold mb-3">Ventas al por mayor</h4>
                    <p class="mb-4">Abastecemos a restaurantes, hoteles y mercados con productos frescos del día.</p>
                    <a href="#contacto" class="btn btn-light rounded-pill fw-bold hover-scale mt-auto">Cotizar Ahora</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Sección Contacto y Footer -->
<footer id="contacto" class="bg-dark text-white pt-5">
    <div class="container py-5">
        <div class="row g-5">
            <div class="col-lg-4">
                <img src="asopro.jpeg" alt="ASOPROPESMAR" height="60" class="mb-4 bg-white p-2 rounded">
                <p class="text-white-50 mb-4">Asociación de Producción Pesquera Manabí Artesanal. Llevando lo mejor del mar a su mesa desde Manta, Ecuador.</p>
                <div class="social-links d-flex gap-3">
                    <a href="#" class="bg-primary text-white d-flex align-items-center justify-content-center rounded-circle" style="width: 40px; height: 40px;"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="bg-primary text-white d-flex align-items-center justify-content-center rounded-circle" style="width: 40px; height: 40px;"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="bg-primary text-white d-flex align-items-center justify-content-center rounded-circle" style="width: 40px; height: 40px;"><i class="bi bi-whatsapp"></i></a>
                </div>
            </div>

            <div class="col-lg-4">
                <h4 class="fw-bold mb-4">Contáctanos</h4>
                <ul class="list-unstyled d-flex flex-column gap-3">
                    <li class="d-flex align-items-center">
                        <i class="bi bi-geo-alt text-primary fs-5 me-3"></i>
                        <span class="text-white-50">Puerto de Manta, Manabí, Ecuador</span>
                    </li>
                    <li class="d-flex align-items-center">
                        <i class="bi bi-telephone text-primary fs-5 me-3"></i>
                        <span class="text-white-50">+593 99 999 9999</span>
                    </li>
                    <li class="d-flex align-items-center">
                        <i class="bi bi-envelope text-primary fs-5 me-3"></i>
                        <span class="text-white-50">info@asopropesmar.com</span>
                    </li>
                    <li class="d-flex align-items-center">
                        <i class="bi bi-clock text-primary fs-5 me-3"></i>
                        <span class="text-white-50">Lun - Vie: 05:00 AM - 18:00 PM</span>
                    </li>
                </ul>
            </div>

            <div class="col-lg-4">
                <h4 class="fw-bold mb-4">Envíanos un mensaje</h4>
                <form class="contact-form">
                    <div class="mb-3">
                        <input type="text" class="form-control bg-dark text-white border-secondary" placeholder="Nombre completo">
                    </div>
                    <div class="mb-3">
                        <input type="email" class="form-control bg-dark text-white border-secondary" placeholder="Correo electrónico">
                    </div>
                    <div class="mb-3">
                        <textarea class="form-control bg-dark text-white border-secondary" rows="3" placeholder="Tu mensaje"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold">Enviar Mensaje</button>
                </form>
            </div>
        </div>
    </div>

    <div class="border-top border-secondary text-center py-4">
        <p class="mb-0 text-white-50">&copy; 2024 ASOPROPESMAR. Todos los derechos reservados.</p>
    </div>
</footer>
