<!-- Hero Section -->
<section id="inicio" class="hero-section text-center">
    <div class="container position-relative z-index-1">
        <h1 class="display-3 fw-bold text-white mb-4 animate__animated animate__fadeInDown">
            Asociación de Producción Pesquera<br>Manabí Artesanal
        </h1>
        <p class="lead text-white-50 mb-5 animate__animated animate__fadeInUp animate__delay-1s">
            Impulsando el desarrollo sostenible de nuestros pescadores artesanales y acuicultores hacia el 2026.
        </p>
        <div class="animate__animated animate__zoomIn animate__delay-2s">
            <a href="#servicios" class="btn btn-primary btn-lg me-3 px-5 py-3 rounded-pill fw-bold">Nuestros Servicios</a>
            <a href="#contacto" class="btn btn-outline-light btn-lg px-5 py-3 rounded-pill fw-bold">Contáctanos</a>
        </div>
    </div>
</section>

<!-- Nosotros Section -->
<section id="nosotros" class="section bg-white">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="position-relative">
                    <img src="asopro.jpeg" alt="Pescadores Artesanales" class="img-fluid rounded-4 shadow-lg">
                    <div class="position-absolute bottom-0 end-0 bg-primary text-white p-4 rounded-4 shadow translate-middle-y me-n4 d-none d-lg-block">
                        <h3 class="fw-bold mb-0">15+ Años</h3>
                        <p class="mb-0">De Experiencia</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <h2 class="section-title">Nuestra Historia</h2>
                <p class="lead text-muted mb-4">ASOPROPESMAR nace de la unión y el esfuerzo de los pescadores artesanales de Manabí.</p>
                <div class="row g-4 mt-2">
                    <div class="col-sm-6">
                        <div class="d-flex">
                            <div class="feature-icon bg-primary bg-opacity-10 text-primary rounded px-3 py-2 me-3">
                                <i class="bi bi-bullseye fs-4"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold">Misión</h5>
                                <p class="text-muted small">Promover el desarrollo integral y sostenible de la pesca artesanal.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex">
                            <div class="feature-icon bg-success bg-opacity-10 text-success rounded px-3 py-2 me-3">
                                <i class="bi bi-eye fs-4"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold">Visión 2026</h5>
                                <p class="text-muted small">Ser la asociación líder en innovación pesquera en Ecuador.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Servicios Section -->
<section id="servicios" class="section bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title text-center">Nuestros Servicios</h2>
            <p class="text-muted">Apoyo integral para nuestros asociados</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="service-card h-100 p-4">
                    <div class="icon-box bg-primary text-white mb-4">
                        <i class="bi bi-shield-check fs-2"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Asesoría Legal</h4>
                    <p class="text-muted mb-0">Gestión de permisos, licencias y representación legal para el sector pesquero.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="service-card h-100 p-4">
                    <div class="icon-box bg-success text-white mb-4">
                        <i class="bi bi-graph-up-arrow fs-2"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Capacitación</h4>
                    <p class="text-muted mb-0">Programas de formación en nuevas tecnologías pesqueras y sostenibilidad.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="service-card h-100 p-4">
                    <div class="icon-box bg-warning text-white mb-4">
                        <i class="bi bi-basket fs-2"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Comercialización</h4>
                    <p class="text-muted mb-0">Apoyo en la cadena de valor y búsqueda de mejores mercados para nuestros productos.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Socios Section (Dashboard) -->
<section id="socios" class="section bg-white">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title text-center">Gestión de Socios 2026</h2>
            <p class="text-muted">Sistema de administración de asociados</p>
        </div>

        <div id="adminPanel" class="dashboard-container">
            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <div class="stat-card">
                        <i class="bi bi-people-fill fs-1 mb-3"></i>
                        <div class="stat-number" id="totalMembers">0</div>
                        <p>Total Asociados</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-card">
                        <i class="bi bi-person-check-fill fs-1 mb-3"></i>
                        <div class="stat-number" id="activeMembers">0</div>
                        <p>Activos</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-card">
                        <i class="bi bi-person-dash-fill fs-1 mb-3"></i>
                        <div class="stat-number" id="inactiveMembers">0</div>
                        <p>Inactivos</p>
                    </div>
                </div>
            </div>

            <div class="db-section">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="mb-0"><i class="bi bi-database me-2"></i>Base de Datos de Asociados</h4>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#memberModal">
                        <i class="bi bi-plus-circle me-1"></i> Nuevo Asociado
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover" id="membersTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Email</th>
                                <th>Teléfono</th>
                                <th>Tipo</th>
                                <th>Estado</th>
                                <th>Fecha</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="membersTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

