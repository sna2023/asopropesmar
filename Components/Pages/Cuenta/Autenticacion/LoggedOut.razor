@page "/Cuenta/Autenticacion/LoggedOut"

<div class="container text-center mt-5 pt-5">
    <div class="card mx-auto shadow-lg" style="max-width: 500px;">
        <div class="card-body p-5">
            <h1 class="display-4 text-primary mb-4">
                <i class="bi bi-shield-check"></i>
            </h1>
            <h2 class="mb-4">Has cerrado sesión</h2>
            <p class="text-muted mb-4">Has cerrado sesión exitosamente. Vuelve pronto.</p>
            <a href="@AsopropesmarApp.Helpers.Route.Cuenta.Autenticacion.Login" class="btn btn-lg btn-primary fw-bolder" data-enhance-nav="false">
                Iniciar Sesión
            </a>
        </div>
    </div>
</div>
