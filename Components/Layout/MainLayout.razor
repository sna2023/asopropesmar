@inherits LayoutComponentBase
@inject NavigationManager _navigation
@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
    <NotAuthorized>
        @Body
    </NotAuthorized>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4">
                    <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
                    <a href="/Cuenta/Autenticacion/Logout" data-enhance-nav="false">Cerrar Sesión</a>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>

        <div id="blazor-error-ui">
            An unhandled error has occurred.
            <a href="" class="reload">Reload</a>
            <a class="dismiss">🗙</a>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStat { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = AuthStat != null ? await AuthStat : null;
        var user = authState?.User;
        if (user is null || user.Identity is null || !user.Identity.IsAuthenticated)
        {
            var relativePath = "/" + _navigation.ToBaseRelativePath(_navigation.Uri);
            if (!string.Equals(relativePath, "/Cuenta/Autenticacion/LoggedOut", StringComparison.OrdinalIgnoreCase) &&
                !string.Equals(relativePath, "/Cuenta/Autenticacion/Login", StringComparison.OrdinalIgnoreCase))
            {
                _navigation.NavigateTo("/Cuenta/Autenticacion/LoggedOut", forceLoad: false);
            }
        }
    }
}
